<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Propama POS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PropamaPOS.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="preload">
    <div class="app-root d-flex">
        <!-- Sidebar -->
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <partial name="_Sidebar" />
        }

        <!-- Columna derecha -->
        <div class="main-column d-flex flex-column flex-grow-1 @(!(User.Identity?.IsAuthenticated ?? false) ? "full-width" : "")">
            <!-- Navbar -->
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <header>
                    <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow mb-0">
                        <div class="container-fluid">
                            <button id="sidebarToggleBtn" class="btn btn-outline-warning me-2" type="button" aria-label="Toggle sidebar">
                                <i class="bi bi-list fs-5"></i>
                            </button>
                            <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-shop-window me-2"></i>Propama POS
                            </a>

                            <!-- Botón de menú para móvil - Cambiado a tres puntos -->
                            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>

                            <div class="collapse navbar-collapse" id="navbarContent">
                                <ul class="navbar-nav me-auto">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-house me-1"></i>Inicio
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                            <i class="bi bi-shield-check me-1"></i>Privacidad
                                        </a>
                                    </li>
                                </ul>

                                <!-- Sesión -->
                                <ul class="navbar-nav">
                                    <li class="nav-item">
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-link nav-link py-2 px-3" style="color: inherit; text-decoration: none;">
                                                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </nav>
                </header>
            }

            <!-- Alertas -->
            @* <partial name="_AlertsPartial" /> *@

            <!-- Contenido principal -->
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <main class="main-content flex-grow-1">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="login-main-content">
                    @RenderBody()
                </main>
            }

            <!-- Footer -->
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <footer class="footer border-top text-muted py-3 mt-auto">
                    <div class="container text-center">
                        &copy; 2025 - Propama POS - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-warning text-decoration-none">Política de Privacidad</a>
                    </div>
                </footer>
            }
        </div> <!-- /.main-column -->
    </div> <!-- /.app-root -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>