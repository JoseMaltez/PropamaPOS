@model IEnumerable<PropamaPOS.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
    string q = ViewBag.CurrentQuery as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-truck"></i> Gestión de Proveedores</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Proveedor
        </a>
    </div>

    <!-- FILTRO DE BÚSQUEDA -->
    <form method="get" asp-action="Index" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Buscar proveedor</label>
                    <input type="text" name="q" value="@q" class="form-control"
                           placeholder="Buscar por nombre, teléfono, correo o dirección..." />
                </div>

                <div class="col-md-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </a>
                </div>
            </div>
        </div>
    </form>

    @await Html.PartialAsync("_AlertsPartial")

    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list"></i> Lista de Proveedores</h5>
            <small>Total: @totalItems registros</small>
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-truck display-1 text-muted"></i>
                    <h5 class="text-muted">No se encontraron proveedores</h5>
                    <a asp-action="Crear" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Crear Proveedor
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Dirección</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proveedor in Model)
                            {
                                <tr>
                                    <td>@proveedor.Id_Proveedor</td>
                                    <td>@proveedor.Nombre</td>
                                    <td>@proveedor.Telefono</td>
                                    <td>@proveedor.Correo</td>
                                    <td>@proveedor.Direccion</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Editar" asp-route-id="@proveedor.Id_Proveedor"
                                               class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Eliminar" asp-route-id="@proveedor.Id_Proveedor"
                                               class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINACIÓN -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>Mostrando página @currentPage de @totalPages</div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-q="@q">‹</a>
                            </li>
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-q="@q">›</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
