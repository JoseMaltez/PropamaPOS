@model IEnumerable<PropamaPOS.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
    string q = ViewBag.CurrentQuery as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid mt-4 proveedor-fade-in">
    <!-- Header -->
    <div class="proveedor-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="proveedor-title">
                    <i class="bi bi-truck me-3"></i>Gestión de Proveedores
                </h1>
                <p class="proveedor-subtitle mb-0">
                    Administra y mantén actualizada la información de tus proveedores
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Crear" class="btn btn-warning btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Crear Proveedor
                </a>
            </div>
        </div>
    </div>

    <!-- Filtro de Búsqueda -->
    <div class="proveedor-search-card">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Buscar proveedor</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="q" value="@q" class="form-control border-start-0"
                               placeholder="Buscar por nombre, teléfono, correo o dirección..." />
                    </div>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-2"></i>Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_AlertsPartial")

    <!-- Tabla de Proveedores -->
    <div class="proveedor-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white">
                <i class="bi bi-list-ul me-2"></i>Lista de Proveedores
            </h5>
            <span class="badge bg-warning text-dark fs-6">Total: @totalItems registros</span>
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="proveedores-empty-state">
                    <i class="bi bi-truck proveedores-empty-icon"></i>
                    <h5 class="text-muted mb-3">No se encontraron proveedores</h5>
                    <p class="text-muted mb-4">Comienza agregando tu primer proveedor al sistema.</p>
                    <a asp-action="Crear" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Crear Proveedor
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table proveedores-table">
                        <thead>
                            <tr>
                                <th width="80">ID</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Dirección</th>
                                <th width="120" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proveedor in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-primary">#@proveedor.Id_Proveedor</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-building me-2 text-muted"></i>
                                            <span class="fw-medium">@proveedor.Nombre</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-telephone me-2 text-muted"></i>
                                            @proveedor.Telefono
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(proveedor.Correo))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-envelope me-2 text-muted"></i>
                                                <a href="mailto:@proveedor.Correo" class="text-decoration-none">@proveedor.Correo</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No especificado</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(proveedor.Direccion))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-geo-alt me-2 text-muted"></i>
                                                <span class="text-truncate" style="max-width: 200px;"
                                                      title="@proveedor.Direccion">@proveedor.Direccion</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No especificada</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Editar" asp-route-id="@proveedor.Id_Proveedor"
                                               class="btn btn-proveedor-edit btn-proveedor-action"
                                               data-bs-toggle="tooltip" title="Editar proveedor">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Eliminar" asp-route-id="@proveedor.Id_Proveedor"
                                               class="btn btn-proveedor-delete btn-proveedor-action"
                                               data-bs-toggle="tooltip" title="Eliminar proveedor">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <div class="text-muted">
                            Página <strong>@currentPage</strong> de <strong>@totalPages</strong>
                            - <strong>@totalItems</strong> proveedores
                        </div>
                        <nav>
                            <ul class="pagination proveedores-pagination mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-q="@q">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Index"
                                               asp-route-page="@i"
                                               asp-route-q="@q">@i</a>
                                        </li>
                                    }
                                    else if (i == currentPage - 3 || i == currentPage + 3)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-q="@q">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // tooltips
            const tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            if (tooltips.length > 0 && typeof bootstrap !== 'undefined') {
                [...tooltips].map(el => new bootstrap.Tooltip(el));
            }
        });
    </script>
}