@model PropamaPOS.Models.ViewModels.ProveedorViewModel

@{
    ViewData["Title"] = "Crear Proveedor";
}

<div class="container-fluid mt-4 proveedor-fade-in">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <!-- Header -->
            <div class="proveedor-header">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="proveedor-title">
                            <i class="bi bi-plus-circle me-3"></i>Crear Nuevo Proveedor
                        </h1>
                        <p class="proveedor-subtitle mb-0">
                            Completa la información para registrar un nuevo proveedor en el sistema
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                        </a>
                    </div>
                </div>
            </div>

            <!-- Formulario -->
            <div class="proveedor-card">
                <div class="card-body">
                    <form asp-action="Crear" method="post" class="proveedor-form">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label">
                                    <i class="bi bi-building me-1"></i>Nombre del Proveedor *
                                </label>
                                <input asp-for="Nombre" class="form-control"
                                       placeholder="Ingrese el nombre completo del proveedor" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label">
                                    <i class="bi bi-telephone me-1"></i>Teléfono
                                </label>
                                <input asp-for="Telefono" type="tel" class="form-control"
                                       placeholder="Ingrese el número de teléfono" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">
                                <i class="bi bi-envelope me-1"></i>Correo Electrónico
                            </label>
                            <input asp-for="Correo" type="email" class="form-control"
                                   placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Direccion" class="form-label">
                                <i class="bi bi-geo-alt me-1"></i>Dirección
                            </label>
                            <textarea asp-for="Direccion" class="form-control" rows="4"
                                      placeholder="Ingrese la dirección completa del proveedor..."></textarea>
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-check-circle me-2"></i>Crear Proveedor
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}