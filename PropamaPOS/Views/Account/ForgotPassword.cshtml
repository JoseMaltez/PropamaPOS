@model PropamaPOS.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="login-main-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-container">
                    <!-- Header -->
                    <div class="login-header">
                        <div class="login-logo">
                            <i class="bi bi-key"></i>
                        </div>
                        <h1 class="login-title">Recuperar Contraseña</h1>
                        <p class="login-subtitle">Ingresa tu email para recibir el enlace de recuperación</p>
                    </div>

                    <!-- Formulario -->
                    <form asp-action="ForgotPassword" method="post" class="account-form">
                        <div class="form-group">
                            <label asp-for="Email" class="form-label">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0"
                                       placeholder="ejemplo@correo.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-account-primary">
                            <i class="bi bi-send me-2"></i>Enviar Enlace de Recuperación
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-controller="Account" asp-action="Login" class="account-link">
                            <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                        </a>
                    </div>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info account-alert mt-4">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            @TempData["Message"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}