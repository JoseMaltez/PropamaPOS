@model PropamaPOS.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Restablecer Contraseña</h3>
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState[""].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Nueva Contraseña</label>
                            <div class="input-group mb-2">
                                <input asp-for="Password" class="form-control" type="password"
                                       id="passwordInput"
                                       placeholder="Ingrese la nueva contraseña" required />
                                <button type="button" class="btn btn-outline-secondary toggle-password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>

                            <div class="mt-2" id="passwordRequirements">
                                <small class="text-muted">La contraseña debe tener al menos:</small>
                                <ul class="list-unstyled ms-3 mt-1">
                                    <li id="req-length"><i class="bi bi-x-circle text-danger me-1"></i>8 caracteres</li>
                                    <li id="req-upper"><i class="bi bi-x-circle text-danger me-1"></i>1 mayúscula (A–Z)</li>
                                    <li id="req-lower"><i class="bi bi-x-circle text-danger me-1"></i>1 minúscula (a–z)</li>
                                    <li id="req-number"><i class="bi bi-x-circle text-danger me-1"></i>1 número (0–9)</li>
                                    <li id="req-special"><i class="bi bi-x-circle text-danger me-1"></i>1 carácter especial (&#64;&#35;&#36;&#37;&#94;&amp;&#42;&#33;&#63;)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                            <div class="input-group mb-3">
                                <input asp-for="ConfirmPassword" class="form-control" type="password"
                                       placeholder="Repita la contraseña" required />
                                <button type="button" class="btn btn-outline-secondary toggle-password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Guardar nueva contraseña</button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="Login">Volver al inicio de sesión</a>
                    </div>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info mt-3">@TempData["Message"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("passwordInput");

            // Elementos de la lista
            const reqLength = document.getElementById("req-length");
            const reqUpper = document.getElementById("req-upper");
            const reqLower = document.getElementById("req-lower");
            const reqNumber = document.getElementById("req-number");
            const reqSpecial = document.getElementById("req-special");

            passwordInput.addEventListener("input", function () {
                const value = passwordInput.value;

                // Condiciones
                const hasLength = value.length >= 8;
                const hasUpper = /[A-Z]/.test(value);
                const hasLower = /[a-z]/.test(value);
                const hasNumber = /\d/.test(value);
                const hasSpecial = /[^A-Za-z0-9]/.test(value);

                // Actualizar cada ítem visualmente
                updateItem(reqLength, hasLength);
                updateItem(reqUpper, hasUpper);
                updateItem(reqLower, hasLower);
                updateItem(reqNumber, hasNumber);
                updateItem(reqSpecial, hasSpecial);
            });

            function updateItem(element, condition) {
                const icon = element.querySelector("i");
                if (condition) {
                    icon.classList.remove("bi-x-circle", "text-danger");
                    icon.classList.add("bi-check-circle", "text-success");
                } else {
                    icon.classList.remove("bi-check-circle", "text-success");
                    icon.classList.add("bi-x-circle", "text-danger");
                }
            }
        });
    </script>
}
