@model PropamaPOS.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="login-main-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-container">
                    <!-- Header -->
                    <div class="login-header">
                        <div class="login-logo">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h1 class="login-title">Nueva Contraseña</h1>
                        <p class="login-subtitle">Crea una nueva contraseña segura para tu cuenta</p>
                    </div>

                    <!-- Validación general -->
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger account-alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @foreach (var error in ViewData.ModelState[""].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <!-- Formulario -->
                    <form asp-action="ResetPassword" method="post" class="account-form">
                        <input type="hidden" asp-for="Token" />

                        <div class="form-group">
                            <label asp-for="Password" class="form-label">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password" class="form-control border-start-0" type="password"
                                       id="passwordInput" placeholder="Ingrese la nueva contraseña" required />
                                <button type="button" class="btn btn-outline-secondary toggle-password border-start-0">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>

                            <!-- Indicadores de seguridad -->
                            <div class="password-requirements mt-3">
                                <small class="text-muted fw-bold">Requisitos de seguridad:</small>
                                <ul class="list-unstyled mt-2 mb-0">
                                    <li id="req-length"><i class="bi bi-x-circle text-danger me-2"></i>Mínimo 8 caracteres</li>
                                    <li id="req-upper"><i class="bi bi-x-circle text-danger me-2"></i>Una letra mayúscula (A-Z)</li>
                                    <li id="req-lower"><i class="bi bi-x-circle text-danger me-2"></i>Una letra minúscula (a-z)</li>
                                    <li id="req-number"><i class="bi bi-x-circle text-danger me-2"></i>Un número (0-9)</li>
                                    <li id="req-special"><i class="bi bi-x-circle text-danger me-2"></i>Un carácter especial (&#64;&#35;&#36;&#37;&#94;&amp;&#42;&#33;&#63;)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0" type="password"
                                       placeholder="Repita la contraseña" required />
                                <button type="button" class="btn btn-outline-secondary toggle-password border-start-0">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-account-primary">
                            <i class="bi bi-check-circle me-2"></i>Guardar Nueva Contraseña
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-controller="Account" asp-action="Login" class="account-link">
                            <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                        </a>
                    </div>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info account-alert mt-4">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            @TempData["Message"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("passwordInput");
            const requirements = {
                length: document.getElementById("req-length"),
                upper: document.getElementById("req-upper"),
                lower: document.getElementById("req-lower"),
                number: document.getElementById("req-number"),
                special: document.getElementById("req-special")
            };

            // Toggle password
            document.querySelectorAll(".toggle-password").forEach(btn => {
                btn.addEventListener("click", function () {
                    const input = this.closest('.input-group').querySelector('input');
                    const icon = this.querySelector("i");
                    if (input.type === "password") {
                        input.type = "text";
                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");
                    } else {
                        input.type = "password";
                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    }
                });
            });

            // Validación de contraseña
            passwordInput.addEventListener("input", function () {
                const value = passwordInput.value;
                const checks = {
                    length: value.length >= 8,
                    upper: /[A-Z]/.test(value),
                    lower: /[a-z]/.test(value),
                    number: /\d/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                // indicadores visuales
                Object.keys(checks).forEach(key => {
                    const requirement = requirements[key];
                    const icon = requirement.querySelector("i");
                    const isValid = checks[key];
                    
                    if (isValid) {
                        icon.classList.remove("bi-x-circle", "text-danger");
                        icon.classList.add("bi-check-circle", "text-success");
                        requirement.classList.add("valid");
                        requirement.classList.remove("invalid");
                    } else {
                        icon.classList.remove("bi-check-circle", "text-success");
                        icon.classList.add("bi-x-circle", "text-danger");
                        requirement.classList.add("invalid");
                        requirement.classList.remove("valid");
                    }
                });
            });
        });
    </script>
}