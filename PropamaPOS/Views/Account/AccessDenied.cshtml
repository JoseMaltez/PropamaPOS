@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Acceso Denegado";
    var user = HttpContextAccessor.HttpContext?.User;
    bool isAdmin = user?.IsInRole("Admin") ?? false;
    bool isEmpleado = user?.IsInRole("Empleado") ?? false;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger shadow-lg p-4 text-center">
                <h3 class="mb-3">🚫 Acceso Denegado</h3>
                <p>No tienes permisos para acceder a esta página.</p>
                @if (isAdmin)
                {
                    <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-primary mt-3">Volver a Inicio</a>
                }
                @if (isEmpleado)
                {
                    <a asp-action="Dashboard" asp-controller="Empleado" class="btn btn-primary mt-3">Volver a Inicio</a>
                }
            </div>
        </div>
    </div>
</div>

