@model IEnumerable<PropamaPOS.Models.Compra>
@{
    ViewData["Title"] = "Reportes - Compras";
    var proveedores = ViewBag.Proveedores as List<PropamaPOS.Models.Proveedor> ?? new();
    var currentProveedor = ViewBag.CurrentProveedor as int?;
    var currentDesde = ViewBag.CurrentDesde as string;
    var currentHasta = ViewBag.CurrentHasta as string;
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-journal-text"></i> Reporte de Compras</h4>
            <div>
                <a asp-controller="Compras" asp-action="Index" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Volver a Compras
                </a>
            </div>
        </div>

        <div class="card-body">
            <form method="get" class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Proveedor</label>
                    <select name="id_Proveedor" class="form-select">
                        <option value="">-- Todos --</option>
                        @foreach (var p in proveedores)
                        {
                            @if (currentProveedor == p.Id_Proveedor)
                            {
                                <option value="@p.Id_Proveedor" selected>@p.Nombre</option>
                            }
                            else
                            {
                                <option value="@p.Id_Proveedor">@p.Nombre</option>
                            }

                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" name="desde" class="form-control" value="@currentDesde" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="hasta" class="form-control" value="@currentHasta" />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary mt-1">Limpiar</a>
                </div>
            </form>

            <div class="mb-3 d-flex justify-content-end gap-2">
                <a asp-action="DownloadComprasPdf" asp-route-id_Proveedor="@currentProveedor" asp-route-desde="@currentDesde" asp-route-hasta="@currentHasta"
                   class="btn btn-success">
                    <i class="bi bi-download"></i> Descargar PDF
                </a>
            </div>

            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Número</th>
                        <th>Proveedor</th>
                        <th>Líneas</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@c.NumeroCompra</td>
                            <td>@c.Proveedor?.Nombre</td>
                            <td>@(c.Detalles?.Count ?? 0)</td>
                            <td class="text-end">Q@(c.Subtotal.ToString("F2"))</td>
                            <td class="text-end">Q@(c.IVA.ToString("F2"))</td>
                            <td class="text-end">Q@(c.Total.ToString("F2"))</td>
                            <td>
                                <a asp-controller="Compras" asp-action="Details" asp-route-id="@c.Id_Compra" class="btn btn-sm btn-outline-secondary">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script>
    </script>
}
