@model IEnumerable<PropamaPOS.Models.Compra>
@{
    ViewData["Title"] = "Reportes - Compras";
    var proveedores = ViewBag.Proveedores as List<PropamaPOS.Models.Proveedor> ?? new();
    var currentProveedor = ViewBag.CurrentProveedor as int?;
    var currentDesde = ViewBag.CurrentDesde as string;
    var currentHasta = ViewBag.CurrentHasta as string;
    var currentNumero = ViewBag.CurrentNumero as string;
    var currentEmpleado = ViewBag.CurrentEmpleado as string;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")

    <div class="report-card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0 text-white">
                    <i class="bi bi-journal-text me-2"></i>Reporte de Compras
                </h4>
                <small class="text-white-50">Gestión y análisis de compras realizadas</small>
            </div>
            <div>
                <a asp-controller="Compras" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Volver a Compras
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- FILTROS -->
            <div class="report-filters mb-4">
                <h5 class="text-primary">
                    <i class="bi bi-funnel-fill"></i>Filtros de Búsqueda
                </h5>

                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Número de compra</label>
                        <input type="text" name="numero" value="@currentNumero"
                               class="form-control" placeholder="Ej: CMP-000001" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Proveedor</label>
                        <input type="text" name="proveedor" value="@ViewBag.CurrentProveedorTexto"
                               class="form-control" placeholder="Nombre del proveedor" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Empleado</label>
                        <input type="text" name="empleado" value="@currentEmpleado"
                               class="form-control" placeholder="Nombre del empleado" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Fecha desde</label>
                        <input type="date" name="desde" value="@currentDesde"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Fecha hasta</label>
                        <input type="date" name="hasta" value="@currentHasta"
                               class="form-control" />
                    </div>

                    <div class="col-12 d-flex justify-content-end align-items-end gap-2 pt-3">
                        <button class="btn btn-primary px-4" type="submit">
                            <i class="bi bi-search me-1"></i>Aplicar Filtros
                        </button>
                        <a class="btn btn-outline-secondary px-4" href="@Url.Action("Index", "Reportes")">
                            <i class="bi bi-x-lg me-1"></i>Limpiar
                        </a>
                    </div>
                </form>
            </div>

            <!-- BOTONES DE ACCIÓN -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <span>Total de registros: @totalItems</span>
                </div>
                <div>
                    <a asp-action="DownloadComprasPdf"
                       asp-route-id_Proveedor="@currentProveedor"
                       asp-route-desde="@currentDesde"
                       asp-route-hasta="@currentHasta"
                       asp-route-numero="@currentNumero"
                       asp-route-empleado="@currentEmpleado"
                       class="btn btn-download">
                        <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
                    </a>
                </div>
            </div>

            <!-- TABLA -->
            <div class="table-responsive">
                <table class="table report-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Número</th>
                            <th>Proveedor</th>
                            <th>Empleado</th>
                            <th class="text-center">Líneas</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">IVA</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            decimal totalSubtotal = 0, totalIva = 0, totalTotal = 0;

                            @foreach (var c in Model)
                            {
                                totalSubtotal += c.Subtotal;
                                totalIva += c.IVA;
                                totalTotal += c.Total;

                                <tr>
                                    <td class="fw-semibold">@c.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-primary">@c.NumeroCompra</span></td>
                                    <td>@c.Proveedor?.Nombre</td>
                                    <td>@(c.Empleado != null ? $"{c.Empleado.Nombre} {c.Empleado.Apellido}" : c.CreadoPor)</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@(c.Detalles?.Count ?? 0)</span>
                                    </td>
                                    <td class="text-end">Q@(c.Subtotal.ToString("F2"))</td>
                                    <td class="text-end">Q@(c.IVA.ToString("F2"))</td>
                                    <td class="text-end fw-bold text-primary">Q@(c.Total.ToString("F2"))</td>
                                </tr>
                            }

                            <!-- FILA DE TOTALES -->
                            <tr class="report-totals">
                                <td colspan="5" class="text-end fw-bold">TOTALES:</td>
                                <td class="text-end fw-bold">Q@(totalSubtotal.ToString("F2"))</td>
                                <td class="text-end fw-bold">Q@(totalIva.ToString("F2"))</td>
                                <td class="text-end fw-bold text-success">Q@(totalTotal.ToString("F2"))</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox display-4 d-block mb-2 opacity-50"></i>
                                    <h5 class="mb-2">No se encontraron compras</h5>
                                    <p class="mb-0">No hay registros que coincidan con los filtros aplicados.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINACIÓN -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div class="text-muted small">
                        Mostrando página @currentPage de @totalPages | Total: @totalItems registros
                    </div>
                    <nav>
                        <ul class="pagination report-pagination mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { id_Proveedor = currentProveedor, desde = currentDesde, hasta = currentHasta, numero = currentNumero, empleado = currentEmpleado, page = currentPage - 1 })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                if (p >= currentPage - 2 && p <= currentPage + 2)
                                {
                                    <li class="page-item @(p == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { id_Proveedor = currentProveedor, desde = currentDesde, hasta = currentHasta, numero = currentNumero, empleado = currentEmpleado, page = p })">@p</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { id_Proveedor = currentProveedor, desde = currentDesde, hasta = currentHasta, numero = currentNumero, empleado = currentEmpleado, page = currentPage + 1 })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof ReportUtils !== 'undefined') {
                ReportUtils.initializeReportComponents();
            }
        });
    </script>
}