@model IEnumerable<PropamaPOS.Models.Item>
@{
    ViewData["Title"] = "Reportes - Inventario";
    var categorias = ViewBag.Categorias as List<PropamaPOS.Models.Categoria> ?? new();
    var currentCategoria = ViewBag.CurrentCategoria as int?;
    var currentBajoStock = ViewBag.CurrentBajoStock as bool?;
    var currentMinStock = ViewBag.CurrentMinStock as int?;
    var currentQ = ViewBag.CurrentQ as string;
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-box-seam"></i> Reporte de Inventario</h4>
            <div>
                <a asp-controller="Item" asp-action="Index" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Ir a Productos
                </a>
            </div>
        </div>

        <div class="card-body">
            <form method="get" asp-action="IndexInventario" class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label">Categoría</label>
                    <select name="categoriaId" class="form-select">
                        <option value="">-- Todas --</option>
                        @foreach (var c in categorias)
                        {
                            if (currentCategoria == c.Id_Categoria)
                            {
                                <option value="@c.Id_Categoria" selected>@c.Nombre</option>
                            }
                            else
                            {
                                <option value="@c.Id_Categoria">@c.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Bajo stock</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="bajoStock" value="true" @(currentBajoStock == true ? "checked" : "") />
                        <label class="form-check-label">Sólo bajos</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Umbral</label>
                    <input type="number" name="minStock" class="form-control" value="@(currentMinStock?.ToString() ?? "")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Buscar (nombre o código)</label>
                    <input type="text" name="q" class="form-control" value="@currentQ" />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-action="IndexInventario" class="btn btn-outline-secondary mt-1">Limpiar</a>
                </div>
            </form>

            <div class="mb-3 d-flex justify-content-end gap-2">
                <a asp-action="DownloadInventarioPdf" class="btn btn-success"
                   asp-route-categoriaId="@currentCategoria"
                   asp-route-bajoStock="@(currentBajoStock ?? false)"
                   asp-route-minStock="@currentMinStock"
                   asp-route-q="@currentQ">
                    <i class="bi bi-download"></i> Descargar PDF
                </a>
            </div>

            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Stock Min</th>
                        <th class="text-end">Costo Q</th>
                        <th class="text-end">Precio ref. Q</th>
                        <th class="text-end">Valor Inventario Q</th>
                        <th class="text-end">Utilidad Pot. Q</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        var costo = i.CostoPromedioUnidad;
                        var pres = i.Presentaciones?.FirstOrDefault();
                        var precioRef = pres?.PrecioVenta ?? 0m;
                        var valorInv = Math.Round(i.Stock * costo, 2);
                        var utilidadPot = Math.Round((precioRef - costo) * i.Stock, 2);

                        bool bajoStock = i.Stock <= (i.StockMinimo ?? 0);

                        string filaClase = bajoStock ? "table-warning" : ""; 

                        <tr class="@filaClase">
                            <td>
                                @i.Nombre
                                @if (bajoStock)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Bajo stock</span>
                                }
                            </td>
                            <td>@i.Categoria?.Nombre</td>
                            <td class="text-end">@i.Stock</td>
                            <td class="text-end">@((i.StockMinimo ?? 0))</td>
                            <td class="text-end">Q@(costo.ToString("F2"))</td>
                            <td class="text-end">Q@(precioRef.ToString("F2"))</td>
                            <td class="text-end">Q@(valorInv.ToString("F2"))</td>
                            <td class="text-end">Q@(utilidadPot.ToString("F2"))</td>
                            <td>
                                <a asp-controller="Item" asp-action="Editar" asp-route-id="@i.Id_Item" class="btn btn-sm btn-outline-secondary">Editar</a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
