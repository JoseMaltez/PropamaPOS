@model IEnumerable<PropamaPOS.Models.Item>
@{
    ViewData["Title"] = "Reportes - Inventario";
    var categorias = ViewBag.Categorias as List<PropamaPOS.Models.Categoria> ?? new();
    var currentCategoria = ViewBag.CurrentCategoria as int?;
    var currentBajoStock = ViewBag.CurrentBajoStock as bool?;
    var currentMinStock = ViewBag.CurrentMinStock as int?;
    var currentQ = ViewBag.CurrentQ as string;
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-box-seam"></i> Reporte de Inventario</h4>
            <div>
                <a asp-controller="Item" asp-action="Index" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Ir a Productos
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- FILTROS -->
            <form method="get" class="card shadow-sm mb-4 p-3">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Buscar</label>
                        <input type="text" name="q" value="@currentQ" class="form-control" placeholder="Nombre o código..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Categoría</label>
                        <select name="categoriaId" class="form-select">
                            <option value="">Todas</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id_Categoria" selected="@(currentCategoria == c.Id_Categoria)">
                                    @c.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input type="checkbox" class="form-check-input" id="chkBajoStock" name="bajoStock" value="true" @(currentBajoStock == true ? "checked" : null) />
                            <label class="form-check-label" for="chkBajoStock">Solo bajo stock</label>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex gap-2 mt-4 justify-content-end">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <a asp-action="IndexInventario" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x-circle"></i> Limpiar
                        </a>
                    </div>
                </div>
            </form>

            <div class="mb-3 d-flex justify-content-end gap-2">
                <a asp-action="DownloadInventarioPdf" class="btn btn-success"
                   asp-route-categoriaId="@currentCategoria"
                   asp-route-bajoStock="@(currentBajoStock ?? false)"
                   asp-route-minStock="@currentMinStock"
                   asp-route-q="@currentQ">
                    <i class="bi bi-download"></i> Descargar PDF
                </a>
            </div>

            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Stock Min</th>
                        <th class="text-end">Costo Q</th>
                        <th class="text-end">Precio ref. Q</th>
                        <th class="text-end">Valor Inventario Q</th>
                        <th class="text-end">Utilidad Pot. Q</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        var costo = i.CostoPromedioUnidad;
                        var pres = i.Presentaciones?.FirstOrDefault();
                        var precioRef = pres?.PrecioVenta ?? 0m;
                        var valorInv = Math.Round(i.Stock * costo, 2);
                        var utilidadPot = Math.Round((precioRef - costo) * i.Stock, 2);

                        bool bajoStock = i.Stock <= (i.StockMinimo ?? 0);

                        string filaClase = bajoStock ? "table-warning" : ""; 

                        <tr class="@filaClase">
                            <td>
                                @i.Nombre
                                @if (bajoStock)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Bajo stock</span>
                                }
                            </td>
                            <td>@i.Categoria?.Nombre</td>
                            <td class="text-end">@i.Stock</td>
                            <td class="text-end">@((i.StockMinimo ?? 0))</td>
                            <td class="text-end">Q@(costo.ToString("F2"))</td>
                            <td class="text-end">Q@(precioRef.ToString("F2"))</td>
                            <td class="text-end">Q@(valorInv.ToString("F2"))</td>
                            <td class="text-end">Q@(utilidadPot.ToString("F2"))</td>
                            <td>
                                <a asp-controller="Item" asp-action="Editar" asp-route-id="@i.Id_Item" class="btn btn-sm btn-outline-secondary">Editar</a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
            <!-- PAGINACIÓN -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <small>Mostrando página @ViewBag.CurrentPage de @ViewBag.TotalPages — Total: @ViewBag.TotalItems</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)">Anterior</a>
                            </li>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i >= ViewBag.CurrentPage - 2 && i <= ViewBag.CurrentPage + 2)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i">@i</a>
                                </li>
                            }
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)">Siguiente</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
