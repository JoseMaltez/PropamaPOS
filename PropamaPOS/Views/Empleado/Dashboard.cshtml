<!-- Views/Empleado/Dashboard.cshtml -->
@{
    ViewData["Title"] = "Dashboard Empleado";
}

<div class="container mt-4">
    <h2 class="mb-4">Panel de Empleado</h2>

    <div class="row">
        <!--Ventas-->
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">💰 Ventas</h5>
                    <p class="card-text">Realizar ventas</p>
                    <a asp-action="Ventas" class="btn btn-success">Nueva Venta</a>
                </div>
            </div>
        </div>

        <!--Inventario-->
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">📦 Inventario</h5>
                    <p class="card-text">Consultar inventario</p>
                    <a asp-action="Inventario" class="btn btn-warning">Ver Inventario</a>
                </div>
            </div>
        </div>

        <!--Clientes-->
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">👥 Clientes</h5>
                    <p class="card-text">Gestionar clientes</p>
                    <a asp-action="Clientes" class="btn btn-info">Ver Clientes</a>
                </div>
            </div>
        </div>
    </div>
</div>
