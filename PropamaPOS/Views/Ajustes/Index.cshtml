    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<PropamaPOS.Models.AjusteInventario>
@{
    ViewData["Title"] = "Ajustes de Inventario";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Ajustes de Inventario</h3>
        <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Nuevo ajuste</a>
    </div>

    <table class="table table-sm table-hover">
        <thead class="table-light">
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Motivo</th>
                <th>Empleado</th>
                <th>Líneas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                string tipoColorClass = a.Tipo switch
                {
                    PropamaPOS.Models.TipoMovimientoAjuste.Entrada => "text-success fw-semibold",
                    PropamaPOS.Models.TipoMovimientoAjuste.Salida => "text-danger fw-semibold",
                    _ => "text-secondary"
                };

                <tr>
                    <td>@a.Fecha.ToString("g")</td>
                    <td class="@tipoColorClass">@a.Tipo</td>
                    <td>@a.Motivo</td>
                    <td>@(a.Empleado != null ? a.Empleado.Nombre + " " + a.Empleado.Apellido : a.CreadoPor)</td>
                    <td>@(a.Detalles?.Count ?? 0)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@a.Id_Ajuste" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i> Ver
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

