@model IEnumerable<PropamaPOS.Models.AjusteInventario>
@using PropamaPOS.Models

@{
    ViewData["Title"] = "Ajustes de Inventario";
    string desde = ViewBag.Desde as string;
    string hasta = ViewBag.Hasta as string;
    string empleado = ViewBag.CurrentEmpleado as string ?? "";
    var tipo = ViewBag.CurrentTipo as TipoMovimientoAjuste?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertsPartial")

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 text-dark mb-1">Ajustes de Inventario</h2>
            <p class="text-muted mb-0">Gestión de ajustes de entrada y salida de inventario</p>
        </div>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Nuevo Ajuste
        </a>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="bi bi-funnel me-2"></i>Filtros de Búsqueda
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-dark">Empleado</label>
                    <input type="text" name="empleado" value="@empleado" class="form-control" 
                           placeholder="Nombre del empleado..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-dark">Tipo</label>
                    <select name="tipo" class="form-select">
                        <option value="">Todos los tipos</option>
                        <option value="1" selected="@(tipo == TipoMovimientoAjuste.Entrada)">Entrada</option>
                        <option value="2" selected="@(tipo == TipoMovimientoAjuste.Salida)">Salida</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-dark">Desde</label>
                    <input type="date" name="desde" value="@desde" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-dark">Hasta</label>
                    <input type="date" name="hasta" value="@hasta" class="form-control" />
                </div>
                <div class="col-md-3 d-flex gap-2 align-items-end">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-2"></i>Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="bi bi-list-ul me-2"></i>Resultados
                </h5>
                <span class="badge bg-light text-dark fs-6">@totalItems registros</span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-x display-1 text-muted mb-3"></i>
                    <h5 class="text-muted mb-2">No se encontraron ajustes</h5>
                    <p class="text-muted mb-4">No hay ajustes que coincidan con los criterios de búsqueda</p>
                    <a asp-action="Crear" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Crear Primer Ajuste
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Tipo</th>
                                <th>Motivo</th>
                                <th>Empleado</th>
                                <th class="text-center">Líneas</th>
                                <th class="text-center pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="ms-2">
                                                <p class="fw-semibold text-dark mb-0">
                                                    @a.Fecha.ToString("dd/MM/yyyy")
                                                </p>
                                                <small class="text-muted">@a.Fecha.ToString("hh:mm tt")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (a.Tipo == TipoMovimientoAjuste.Entrada)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-box-arrow-in-down me-1"></i>Entrada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-box-arrow-up me-1"></i>Salida
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark">@a.Motivo</span>
                                    </td>
                                    <td>
                                        <div>
                                            <p class="fw-semibold text-dark mb-0">
                                                @(a.Empleado != null ? $"{a.Empleado.Nombre} {a.Empleado.Apellido}" : a.CreadoPor)
                                            </p>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@(a.Detalles?.Count ?? 0)</span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@a.Id_Ajuste" 
                                               class="btn btn-outline-primary" 
                                               data-bs-toggle="tooltip" 
                                               title="Ver detalles del ajuste">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Mostrando página @currentPage de @totalPages — Total: @totalItems registros
                            </small>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    @if (currentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               href="?page=@(currentPage - 1)&desde=@desde&hasta=@hasta&tipo=@tipo&empleado=@empleado">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }
                                    
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i >= currentPage - 2 && i <= currentPage + 2)
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <a class="page-link" 
                                                   href="?page=@i&desde=@desde&hasta=@hasta&tipo=@tipo&empleado=@empleado">@i</a>
                                            </li>
                                        }
                                    }
                                    
                                    @if (currentPage < totalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               href="?page=@(currentPage + 1)&desde=@desde&hasta=@hasta&tipo=@tipo&empleado=@empleado">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Inicializar tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
}

<style>
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #dee2e6;
    }
    
    .table td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
    }
    
    .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
    }
    
    .pagination .page-link {
        border: 1px solid #dee2e6;
        color: #003566;
    }
    
    .pagination .page-item.active .page-link {
        background-color: #003566;
        border-color: #003566;
        color: white;
    }
    
    .pagination .page-link:hover {
        background-color: #f8f9fa;
        color: #001d3d;
    }
</style>