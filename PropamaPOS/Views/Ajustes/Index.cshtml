@model IEnumerable<PropamaPOS.Models.AjusteInventario>
@using PropamaPOS.Models

@{
    ViewData["Title"] = "Ajustes de Inventario";
    string desde = ViewBag.Desde as string;
    string hasta = ViewBag.Hasta as string;
    string empleado = ViewBag.CurrentEmpleado as string ?? "";
    var tipo = ViewBag.CurrentTipo as TipoMovimientoAjuste?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-box-seam"></i> Ajustes de Inventario</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo ajuste
        </a>
    </div>

    <!-- Filtros -->
    <form method="get" class="card shadow-sm mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Empleado</label>
                <input type="text" name="empleado" value="@empleado" class="form-control" placeholder="Nombre del empleado" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Tipo</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos</option>
                    <option value="1" selected="@(tipo == TipoMovimientoAjuste.Entrada)">Entrada</option>
                    <option value="2" selected="@(tipo == TipoMovimientoAjuste.Salida)">Salida</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Desde</label>
                <input type="date" name="desde" value="@desde" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Hasta</label>
                <input type="date" name="hasta" value="@hasta" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Limpiar
                </a>
            </div>
        </div>
    </form>

    <!-- Tabla -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list"></i> Resultados</h5>
            <small>Total: @totalItems registros</small>
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-clipboard-x display-1 text-muted"></i>
                    <h5>No se encontraron ajustes.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Motivo</th>
                                <th>Empleado</th>
                                <th>Líneas</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                var tipoColor = a.Tipo == TipoMovimientoAjuste.Entrada ? "success" :
                                a.Tipo == TipoMovimientoAjuste.Salida ? "danger" : "secondary";

                                <tr>
                                    <td>@a.Fecha.ToString("g")</td>
                                    <td>
                                        <span class="badge bg-@tipoColor">@a.Tipo</span>
                                    </td>
                                    <td>@a.Motivo</td>
                                    <td>@(a.Empleado != null ? $"{a.Empleado.Nombre} {a.Empleado.Apellido}" : a.CreadoPor)</td>
                                    <td>@(a.Detalles?.Count ?? 0)</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@a.Id_Ajuste" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small>Mostrando página @currentPage de @totalPages — Total: @totalItems</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(currentPage - 1)&desde=@desde&hasta=@hasta&tipo=@tipo&empleado=@empleado">Anterior</a>
                                </li>
                            }
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i >= currentPage - 2 && i <= currentPage + 2)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&desde=@desde&hasta=@hasta&tipo=@tipo&empleado=@empleado">@i</a>
                                    </li>
                                }
                            }
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(currentPage + 1)&desde=@desde&hasta=@hasta&tipo=@tipo&empleado=@empleado">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
