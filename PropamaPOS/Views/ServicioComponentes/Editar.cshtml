@model PropamaPOS.Models.ServicioComponente
@{
    ViewData["Title"] = "Editar Componente de Servicio";
    var servicios = ViewBag.Servicios as List<PropamaPOS.Models.Item> ?? new();
    var items = ViewBag.Items as List<PropamaPOS.Models.Item> ?? new();
}

<h3>Editar Componente de Servicio</h3>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="Id_ServicioComponente" />

    <div class="mb-3">
        <label class="form-label">Servicio</label>
        <select asp-for="Id_Servicio" class="form-select" required>
            <option value="">-- Seleccionar servicio --</option>
            @foreach (var s in servicios)
            {
                if (Model.Id_Servicio == s.Id_Item)
                {
                    <option value="@s.Id_Item" selected>@s.Nombre</option>
                }
                else
                {
                    <option value="@s.Id_Item">@s.Nombre</option>
                }
            }
        </select>
        <span asp-validation-for="Id_Servicio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Insumo (producto consumido)</label>
        <select asp-for="Id_Item" class="form-select" required>
            <option value="">-- Seleccionar insumo --</option>
            @foreach (var i in items)
            {
                @if (Model.Id_Item == i.Id_Item)
                {
                    <option value="@i.Id_Item" selected>@i.Nombre</option>
                }
                else
                {
                    <option value="@i.Id_Item">@i.Nombre</option>
                }
            }
        </select>
        <span asp-validation-for="Id_Item" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Cantidad por servicio</label>
        <input asp-for="CantidadPorServicio" type="number" step="0.01" class="form-control" required />
        <span asp-validation-for="CantidadPorServicio" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
