@model PropamaPOS.Models.Item
@{
    ViewData["Title"] = "Eliminar Componentes del Servicio";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="bi bi-exclamation-triangle"></i> Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <p class="lead text-center">
                        ¿Estás seguro que deseas eliminar <strong>todos los componentes</strong> del servicio
                        <b>@Model.Nombre</b>?
                    </p>
                    <p class="text-muted text-center mb-4">Esta acción no se puede deshacer.</p>

                    @if (Model.ServicioComponentes != null && Model.ServicioComponentes.Any())
                    {
                        <ul class="list-group mb-4">
                            @foreach (var sc in Model.ServicioComponentes)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @sc.ItemConsumido?.Nombre
                                    <span class="badge bg-secondary">@sc.CantidadPorServicio</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted fst-italic text-center">Este servicio no tiene insumos asociados.</p>
                    }

                    <form asp-action="EliminarServicio" method="post" class="d-flex justify-content-between">
                        <input type="hidden" name="id" value="@Model.Id_Item" />
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Eliminar todos
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
