@model IEnumerable<PropamaPOS.Models.Item>
@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Componentes de Servicios";
    var user = HttpContextAccessor.HttpContext?.User;
    bool isAdmin = user?.IsInRole("Admin") ?? false;
}
@await Html.PartialAsync("_AlertsPartial")

<h3>Insumos de Servicios</h3>

@if (isAdmin)
{
    <p>
        <a asp-action="CrearMultiple" class="btn btn-success">Agregar insumos a un servicio</a>
    </p>
}

<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Servicio</th>
            <th>Insumos y cantidades</th>
            @if (isAdmin)
            {
                <th style="width:200px;">Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var servicio in Model)
        {
            <tr>
                <td class="fw-bold align-top">@servicio.Nombre</td>
                <td>
                    @if (servicio.ServicioComponentes != null && servicio.ServicioComponentes.Any())
                    {
                        <ul class="mb-0 ps-3">
                            @foreach (var comp in servicio.ServicioComponentes)
                            {
                                <li>
                                    @comp.ItemConsumido?.Nombre - <strong>@comp.CantidadPorServicio</strong>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Sin insumos</span>
                    }
                </td>
                @if (isAdmin)
                {
                    <td class="text-center">
                        <a asp-action="EditarServicio" asp-route-id="@servicio.Id_Item" class="btn btn-sm btn-secondary">Editar</a>
                        <a asp-action="EliminarServicio" asp-route-id="@servicio.Id_Item" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
