@model List<PropamaPOS.Models.ServicioComponente>
@{
    ViewData["Title"] = "Editar Insumos del Servicio";
    var items = ViewBag.Items as List<PropamaPOS.Models.Item>;
    var servicioNombre = ViewBag.ServicioNombre as string;
    var servicioId = (int)ViewBag.ServicioId;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">
                        <i class="bi bi-pencil-square"></i> Editar Insumos del Servicio
                    </h3>
                    <h5 class="text-center text-muted mb-4">Servicio: <strong>@servicioNombre</strong></h5>

                    <form asp-action="EditarServicio" method="post">
                        <input type="hidden" name="id" value="@servicioId" />

                        <table class="table table-bordered align-middle" id="componentesTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Insumo</th>
                                    <th style="width: 200px;">Cantidad por Servicio</th>
                                    <th style="width: 100px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var nombreInsumo = Model[i].ItemConsumido?.Nombre ?? "";
                                    var codigoInsumo = Model[i].ItemConsumido?.Codigo ?? "";
                                    <tr>
                                        <td>
                                            <div class="position-relative">
                                                <input type="text" name="[@i].NombreInsumo" class="form-control buscarInsumo"
                                                       value="@($"{nombreInsumo}{(string.IsNullOrEmpty(codigoInsumo) ? "" : " • " + codigoInsumo)}")"
                                                       placeholder="Buscar insumo..." autocomplete="off" />
                                                <input type="hidden" name="[@i].Id_Item" class="insumoIdHidden" value="@Model[i].Id_Item" />
                                                <div class="list-group position-absolute w-100 sugerenciasInsumo" style="z-index:1050; display:none;"></div>
                                            </div>
                                        </td>
                                        <td>
                                            <input name="[@i].CantidadPorServicio" class="form-control" type="number" min="0.01" step="0.01"
                                                   value="@Model[i].CantidadPorServicio" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                        <div class="d-flex justify-content-between">
                            <button type="button" id="addRow" class="btn btn-outline-secondary">
                                <i class="bi bi-plus-circle"></i> Agregar insumo
                            </button>
                            <div>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Volver
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> Guardar cambios
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let index = @Model.Count;

            // Agregar nueva fila con input predictivo
            document.getElementById('addRow').addEventListener('click', function () {
                const row = `
                <tr>
                    <td>
                        <div class="position-relative">
                            <input type="text" name="[${index}].NombreInsumo" class="form-control buscarInsumo"
                                   placeholder="Buscar insumo..." autocomplete="off" />
                            <input type="hidden" name="[${index}].Id_Item" class="insumoIdHidden" />
                            <div class="list-group position-absolute w-100 sugerenciasInsumo" style="z-index:1050; display:none;"></div>
                        </div>
                    </td>
                    <td>
                        <input name="[${index}].CantidadPorServicio" class="form-control" type="number" min="0.01" step="0.01" value="1" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-row">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;
                document.querySelector('#componentesTable tbody').insertAdjacentHTML('beforeend', row);
                index++;
            });

            document.addEventListener('click', e => {
                if (e.target.closest('.remove-row')) e.target.closest('tr').remove();
            });
        })();

        // --- Texto predictivo para Insumos ---
        const items = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(items ?? new object()));

        document.addEventListener('input', function (e) {
            if (!e.target.classList.contains('buscarInsumo')) return;

            const input = e.target;
            const contenedor = input.closest('td');
            const sugBox = contenedor.querySelector('.sugerenciasInsumo');
            const q = input.value.trim().toLowerCase();
            if (!q) { sugBox.style.display = 'none'; return; }

            const matches = items.filter(it =>
                (it.Nombre && it.Nombre.toLowerCase().includes(q)) ||
                (it.Codigo && it.Codigo.toLowerCase().includes(q))
            ).slice(0, 10);

            sugBox.innerHTML = '';
            if (matches.length === 0) { sugBox.style.display = 'none'; return; }

            matches.forEach(m => {
                const el = document.createElement('button');
                el.type = 'button';
                el.className = 'list-group-item list-group-item-action';
                el.innerHTML = `<div><strong>${m.Nombre}</strong><div class="small text-muted">${m.Codigo ?? ''}</div></div>`;
                el.addEventListener('click', () => {
                    input.value = `${m.Nombre}${m.Codigo ? ' • ' + m.Codigo : ''}`;
                    contenedor.querySelector('.insumoIdHidden').value = m.Id_Item;
                    sugBox.style.display = 'none';
                });
                sugBox.appendChild(el);
            });
            sugBox.style.display = 'block';
        });

        // Ocultar sugerencias al hacer clic fuera
        document.addEventListener('click', e => {
            if (!e.target.closest('.list-group') && !e.target.classList.contains('buscarInsumo')) {
                document.querySelectorAll('.list-group').forEach(l => l.style.display = 'none');
            }
        });
    </script>
}

