    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<PropamaPOS.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2><i class="bi bi-tags"></i> Categorías</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Categoría
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"] as string))
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }


    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>@cat.Id_Categoria</td>
                    <td>@cat.Nombre</td>
                    <td>@cat.Descripcion</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@cat.Id_Categoria" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@cat.Id_Categoria" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

