@model PropamaPOS.Models.Categoria
@{
    ViewData["Title"] = "Detalles de Categoría";
}

<div class="container mt-4">
    <h2>Detalles de Categoría</h2>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>
    </dl>
    <a asp-action="Editar" asp-route-id="@Model.Id_Categoria" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

