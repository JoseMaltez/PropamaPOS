@model PropamaPOS.Models.Categoria
@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container-fluid py-4 category-fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Categorías</a></li>
                    <li class="breadcrumb-item active">Eliminar</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>Eliminar Categoría
            </h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="category-card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-trash me-2"></i>Confirmar Eliminación
                    </h5>
                </div>
                <div class="card-body">
                    <div class="delete-confirmation">
                        <div class="delete-confirmation-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>

                        <h4 class="text-center text-danger mb-4">¿Estás seguro de eliminar esta categoría?</h4>

                        <div class="delete-confirmation-details">
                            <div class="row text-start">
                                <div class="col-12 mb-3">
                                    <strong class="text-primary">ID:</strong>
                                    <span class="ms-2">#@Model.Id_Categoria</span>
                                </div>
                                <div class="col-12 mb-3">
                                    <strong class="text-primary">Nombre:</strong>
                                    <span class="ms-2">@Model.Nombre</span>
                                </div>
                                <div class="col-12">
                                    <strong class="text-primary">Descripción:</strong>
                                    <div class="ms-2 mt-1">
                                        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                                        {
                                            <span class="description-text">@Model.Descripcion</span>
                                        }
                                        else
                                        {
                                            <span class="description-empty">Sin descripción</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-4">
                            <div class="d-flex">
                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                                <div>
                                    <strong>Advertencia:</strong> Esta acción no se puede deshacer.
                                    Los productos asociados a esta categoría podrían verse afectados.
                                </div>
                            </div>
                        </div>

                        <form asp-action="Eliminar" method="post" class="mt-4">
                            <input type="hidden" asp-for="Id_Categoria" />
                            <div class="d-flex justify-content-center gap-3">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-x-circle me-2"></i>Cancelar
                                </a>
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="bi bi-trash me-2"></i>Eliminar Categoría
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>