@model PropamaPOS.Models.Categoria
@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container mt-4">
    <h2>Eliminar Categoría</h2>
    <div class="alert alert-warning">
        ¿Estás seguro que deseas eliminar esta categoría?
    </div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>
    </dl>
    <form asp-action="Eliminar" method="post">
        <input type="hidden" asp-for="Id_Categoria" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

