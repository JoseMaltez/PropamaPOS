@model IEnumerable<PropamaPOS.Models.Venta>
@{
    ViewData["Title"] = "Ventas / Facturas";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;
    string currentNumero = ViewBag.CurrentNumero as string;
    int? currentClienteId = ViewBag.CurrentClienteId as int?;
    string currentFechaDesde = ViewBag.CurrentFechaDesde as string;
    string currentFechaHasta = ViewBag.CurrentFechaHasta as string;
    string currentQ = ViewBag.CurrentQ as string;
    var clientes = ViewBag.Clientes as List<PropamaPOS.Models.Cliente> ?? new List<PropamaPOS.Models.Cliente>();
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-receipt"></i> Ventas / Facturas</h4>
            <div>
                <a asp-action="Crear" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i> Nueva Venta
                </a>
            </div>
        </div>

        <div class="card-body">
            <!-- FILTROS -->
            <div class="mb-3">
                <h5 class="mb-3 text-primary"><i class="bi bi-funnel"></i> Filtros de búsqueda</h5>

                <form method="get" class="card p-3 shadow-sm">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label fw-semibold"># Factura</label>
                            <input type="text" name="numero" value="@ViewBag.CurrentNumero" class="form-control" placeholder="Ej: FAC-000001" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Cliente o NIT</label>
                            <input type="text" name="cliente" value="@ViewBag.CurrentCliente" class="form-control" placeholder="Ej: Juan Pérez o 12345678" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Empleado</label>
                            <input type="text" name="empleado" value="@ViewBag.CurrentEmpleado" class="form-control" placeholder="Nombre del empleado" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Método de pago</label>
                            <select name="metodoPago" class="form-select">
                                <option value="">Todos</option>
                                <option value="0" selected="@(ViewBag.CurrentMetodoPago != null && (MetodoPagoVenta)ViewBag.CurrentMetodoPago == MetodoPagoVenta.Efectivo)">Efectivo</option>
                                <option value="1" selected="@(ViewBag.CurrentMetodoPago != null && (MetodoPagoVenta)ViewBag.CurrentMetodoPago == MetodoPagoVenta.Tarjeta)">Tarjeta</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 align-items-end mt-2">
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Desde</label>
                            <input type="date" name="fechaDesde" value="@ViewBag.CurrentFechaDesde" class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Hasta</label>
                            <input type="date" name="fechaHasta" value="@ViewBag.CurrentFechaHasta" class="form-control" />
                        </div>

                        <div class="col-md-8 d-flex justify-content-end gap-2">
                            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Buscar</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Ventas")">
                                <i class="bi bi-x-lg"></i> Limpiar
                            </a>
                        </div>
                    </div>
                </form>
            </div>





            <!-- TABLA -->
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th># Factura</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Empleado</th>
                            <th>Método de Pago</th>
                            <th>Líneas</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>@v.NumeroVenta</td>
                                <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(v.Cliente != null ? $"{v.Cliente.Nombre} {v.Cliente.Apellido}" : v.NombreConsumidor)</td>
                                <td>@(v.Empleado != null ? $"{v.Empleado.Nombre} {v.Empleado.Apellido}" : v.CreadoPor)</td>
                                <td>
                                    <span class="badge bg-@(v.MetodoPago == PropamaPOS.Models.MetodoPagoVenta.Efectivo ? "success" : "info")">
                                        @v.MetodoPago
                                    </span>
                                </td>
                                <td>@(v.Detalles?.Count ?? 0)</td>
                                <td class="fw-bold">Q@(v.Total.ToString("F2"))</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@v.Id_Venta" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <!-- PAGINACIÓN -->
            <div class="d-flex justify-content-between align-items-center">
                <div>Mostrando página @currentPage de @totalPages | Total: @totalItems</div>
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { numero = currentNumero, clienteId = currentClienteId, fechaDesde = currentFechaDesde, fechaHasta = currentFechaHasta, q = currentQ, page = (currentPage - 1) })">‹</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { numero = currentNumero, clienteId = currentClienteId, fechaDesde = currentFechaDesde, fechaHasta = currentFechaHasta, q = currentQ, page = p })">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { numero = currentNumero, clienteId = currentClienteId, fechaDesde = currentFechaDesde, fechaHasta = currentFechaHasta, q = currentQ, page = (currentPage + 1) })">›</a>
                        </li>
                    </ul>
                </nav>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
