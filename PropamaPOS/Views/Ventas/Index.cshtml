@model IEnumerable<PropamaPOS.Models.Venta>
@{
    ViewData["Title"] = "Historial de Ventas";
}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-receipt"></i> Historial de Ventas</h4>
            <a asp-action="Crear" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Nueva Venta
            </a>
        </div>
        <div class="card-body">
            <table id="tablaVentas" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th># Factura</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Total (Q)</th>
                        <th>Registrada por</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td>@v.NumeroVenta</td>
                            <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(v.Cliente != null ? $"{v.Cliente.Nombre} {v.Cliente.Apellido}" : v.NombreConsumidor)</td>
                            <td>@v.Total.ToString("F2")</td>
                            <td>@v.CreadoPor</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@v.Id_Venta" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaVentas').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' },
                order: [[1, 'desc']],
                pageLength: 10
            });
        });
    </script>
}