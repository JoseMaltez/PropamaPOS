@model IEnumerable<PropamaPOS.Models.Venta>
@{
    ViewData["Title"] = "Ventas / Facturas";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;
    string currentNumero = ViewBag.CurrentNumero as string;
    int? currentClienteId = ViewBag.CurrentClienteId as int?;
    string currentFechaDesde = ViewBag.CurrentFechaDesde as string;
    string currentFechaHasta = ViewBag.CurrentFechaHasta as string;
    string currentQ = ViewBag.CurrentQ as string;
    var clientes = ViewBag.Clientes as List<PropamaPOS.Models.Cliente> ?? new List<PropamaPOS.Models.Cliente>();
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertsPartial")

    <!-- Header de página -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2 text-primary"><i class="bi bi-receipt me-2"></i>Ventas / Facturas</h1>
                    <p class="text-muted mb-0">Gestión y consulta de todas las ventas realizadas en el sistema.</p>
                </div>
                <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-circle fs-5"></i>
                    <span class="fw-semibold">Nueva Venta</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Card principal -->
    <div class="venta-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white"><i class="bi bi-funnel me-2"></i>Filtros de Búsqueda</h5>
        </div>

        <div class="card-body">
            <!-- Filtros -->
            <form method="get" class="ventas-filters">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-dark"># Factura</label>
                        <input type="text" name="numero" value="@ViewBag.CurrentNumero" class="form-control" placeholder="FAC-000001" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Cliente o NIT</label>
                        <input type="text" name="cliente" value="@ViewBag.CurrentCliente" class="form-control" placeholder="Nombre o NIT del cliente" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-dark">Empleado</label>
                        <input type="text" name="empleado" value="@ViewBag.CurrentEmpleado" class="form-control" placeholder="Nombre del empleado" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-dark">Método de pago</label>
                        <select name="metodoPago" class="form-select">
                            <option value="">Todos</option>
                            <option value="0" selected="@(ViewBag.CurrentMetodoPago != null && (MetodoPagoVenta)ViewBag.CurrentMetodoPago == MetodoPagoVenta.Efectivo)">Efectivo</option>
                            <option value="1" selected="@(ViewBag.CurrentMetodoPago != null && (MetodoPagoVenta)ViewBag.CurrentMetodoPago == MetodoPagoVenta.Tarjeta)">Tarjeta</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 align-items-end mt-3">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-dark">Desde</label>
                        <input type="date" name="fechaDesde" value="@ViewBag.CurrentFechaDesde" class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-dark">Hasta</label>
                        <input type="date" name="fechaHasta" value="@ViewBag.CurrentFechaHasta" class="form-control" />
                    </div>

                    <div class="col-md-8 d-flex justify-content-end gap-2">
                        <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2" type="submit">
                            <i class="bi bi-search fs-6"></i>
                            <span class="fw-semibold">Buscar</span>
                        </button>
                        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-4 py-2" href="@Url.Action("Index", "Ventas")">
                            <i class="bi bi-x-lg fs-6"></i>
                            <span class="fw-semibold">Limpiar</span>
                        </a>
                    </div>
                </div>
            </form>

            <!-- Tabla de resultados -->
            <div class="mt-4">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table ventas-table">
                            <thead>
                                <tr>
                                    <th># Factura</th>
                                    <th>Fecha</th>
                                    <th>Cliente</th>
                                    <th>Empleado</th>
                                    <th>Método de Pago</th>
                                    <th class="text-center">Líneas</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold text-primary">@v.NumeroVenta</td>
                                        <td>
                                            <div class="text-dark">@v.Fecha.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@v.Fecha.ToString("HH:mm")</div>
                                        </td>
                                        <td>
                                            @if (v.Cliente != null)
                                            {
                                                <div class="text-dark">@v.Cliente.Nombre @v.Cliente.Apellido</div>
                                                <div class="text-muted small">@v.Cliente.NIT</div>
                                            }
                                            else
                                            {
                                                <div class="text-dark">@v.NombreConsumidor</div>
                                                <div class="text-muted small">Consumidor Final</div>
                                            }
                                        </td>
                                        <td>
                                            @if (v.Empleado != null)
                                            {
                                                <div class="text-dark">@v.Empleado.Nombre @v.Empleado.Apellido</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted">@v.CreadoPor</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(v.MetodoPago == PropamaPOS.Models.MetodoPagoVenta.Efectivo ? "badge-pago-efectivo" : "badge-pago-tarjeta")">
                                                @v.MetodoPago
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@(v.Detalles?.Count ?? 0)</span>
                                        </td>
                                        <td class="text-end fw-bold text-success">Q@(v.Total.ToString("F2"))</td>
                                        <td class="text-center">
                                            <a asp-action="Details" asp-route-id="@v.Id_Venta"
                                               class="btn btn-venta-action btn-venta-view"
                                               data-bs-toggle="tooltip"
                                               title="Ver detalles de la venta">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-md-inline">Ver</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted">
                            Mostrando página @currentPage de @totalPages | Total: @totalItems registros
                        </div>
                        <nav>
                            <ul class="pagination ventas-pagination mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { numero = currentNumero, clienteId = currentClienteId, fechaDesde = currentFechaDesde, fechaHasta = currentFechaHasta, q = currentQ, page = (currentPage - 1) })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int p = 1; p <= totalPages; p++)
                                {
                                    <li class="page-item @(p == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { numero = currentNumero, clienteId = currentClienteId, fechaDesde = currentFechaDesde, fechaHasta = currentFechaHasta, q = currentQ, page = p })">@p</a>
                                    </li>
                                }
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { numero = currentNumero, clienteId = currentClienteId, fechaDesde = currentFechaDesde, fechaHasta = currentFechaHasta, q = currentQ, page = (currentPage + 1) })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
                else
                {
                    <div class="ventas-empty-state">
                        <i class="bi bi-receipt ventas-empty-icon"></i>
                        <h5 class="text-muted mb-3">No se encontraron ventas</h5>
                        <p class="text-muted mb-4">No hay registros que coincidan con los filtros aplicados.</p>
                        <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2">
                            <i class="bi bi-plus-circle"></i>
                            <span>Crear primera venta</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Mejorar experiencia en móvil para la tabla
            if (window.innerWidth < 768) {
                document.querySelectorAll('.ventas-table').forEach(table => {
                    table.classList.add('table-sm');
                });
            }
        });
    </script>
}