@model PropamaPOS.Models.Venta
@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-receipt"></i> Factura @Model.NumeroVenta</h4>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Regresar
            </a>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h5>Información del Cliente</h5>
                    @if (Model.Cliente != null)
                    {
                        <p><strong>NIT:</strong> @Model.Cliente.NIT</p>
                        <p><strong>Nombre:</strong> @Model.Cliente.Nombre @Model.Cliente.Apellido</p>
                        <p><strong>Dirección:</strong> @Model.Cliente.Direccion</p>
                    }
                    else
                    {
                        <p><strong>Consumidor Final:</strong> @Model.NombreConsumidor</p>
                    }
                </div>
                <div class="col-md-6">
                    <h5>Información General</h5>
                    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Método de pago:</strong> @Model.MetodoPago</p>
                    <p><strong>Empleado:</strong> @(Model.Empleado != null ? Model.Empleado.Nombre : "No registrado")</p>
                </div>
            </div>

            <hr />
            <h5>Detalle de Productos y Servicios</h5>
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Producto / Servicio</th>
                        <th>Presentación</th>
                        <th>Cant.</th>
                        <th>Precio (Q)</th>
                        <th>Descuento (Q)</th>
                        <th>Subtotal (Q)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var det in Model.Detalles)
                    {
                        <tr>
                            <td>@det.Item?.Nombre</td>
                            <td>@(det.Presentacion != null ? $"{det.Presentacion.UnidadMedida.Nombre} ({det.Presentacion.Cantidad})" : "-")</td>
                            <td>@det.CantidadPresentaciones</td>
                            <td>@det.PrecioVentaPorPresentacion.ToString("F2")</td>
                            <td>@det.Descuento.ToString("F2")</td>
                            <td>@det.Subtotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end fw-bold">Subtotal (Q):</td>
                        <td>@Model.Subtotal.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td colspan="5" class="text-end fw-bold">Descuentos (Q):</td>
                        <td>@Model.Descuentos.ToString("F2")</td>
                    </tr>
                    <tr class="table-success">
                        <td colspan="5" class="text-end fw-bold">Total (Q):</td>
                        <td class="fw-bold">@Model.Total.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>

            <hr />
            <h5>Pago</h5>
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th>Monto (Q)</th>
                        <th>Nota</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in Model.Pagos)
                    {
                        <tr>
                            <td>@pago.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@pago.Metodo</td>
                            <td>@pago.Monto.ToString("F2")</td>
                            <td>@pago.Nota</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-4 d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-secondary me-2">Volver al listado</a>
                <button type="button" class="btn btn-outline-success" onclick="window.print()">
                    <i class="bi bi-printer"></i> Imprimir
                </button>
            </div>
        </div>
    </div>
</div>
