@model PropamaPOS.Models.ViewModels.ClienteViewModel
@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container-fluid mt-4 client-fade-in">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <!-- Header del Formulario -->
            <div class="client-header text-center mb-4">
                <h1 class="client-title mb-2">
                    <i class="bi bi-person-plus-fill me-3"></i>Crear Nuevo Cliente
                </h1>
                <p class="client-subtitle mb-0">
                    Completa la información para registrar un nuevo cliente en el sistema
                </p>
            </div>

            <!-- Formulario -->
            <div class="client-card">
                <div class="card-body">
                    <form asp-action="Crear" method="post" class="client-form">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger client-alert"></div>

                        <div class="row">
                            <!-- NIT -->
                            <div class="col-12 mb-4">
                                <label asp-for="NIT" class="form-label">
                                    <i class="bi bi-credit-card me-2"></i>NIT
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-building text-muted"></i>
                                    </span>
                                    <input asp-for="NIT" class="form-control border-start-0" 
                                           placeholder="Ingrese el NIT del cliente" />
                                </div>
                                <span asp-validation-for="NIT" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Nombre y Apellido -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="Nombre" class="form-label">
                                    <i class="bi bi-person me-2"></i>Nombre
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-fonts text-muted"></i>
                                    </span>
                                    <input asp-for="Nombre" class="form-control border-start-0" 
                                           placeholder="Nombre del cliente" />
                                </div>
                                <span asp-validation-for="Nombre" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Apellido" class="form-label">
                                    Apellido <small class="text-muted">(Opcional)</small>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-fonts text-muted"></i>
                                    </span>
                                    <input asp-for="Apellido" class="form-control border-start-0" 
                                           placeholder="Apellido del cliente" />
                                </div>
                                <span asp-validation-for="Apellido" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Dirección -->
                            <div class="col-12 mb-4">
                                <label asp-for="Direccion" class="form-label">
                                    <i class="bi bi-geo-alt me-2"></i>Dirección
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light align-items-start pt-3 border-end-0">
                                        <i class="bi bi-map text-muted"></i>
                                    </span>
                                    <textarea asp-for="Direccion" class="form-control border-start-0" 
                                              rows="4" placeholder="Ingrese la dirección completa del cliente"></textarea>
                                </div>
                                <span asp-validation-for="Direccion" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Crear Cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}