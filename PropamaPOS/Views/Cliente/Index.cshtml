@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model IEnumerable<PropamaPOS.Models.Cliente>
@{
    ViewData["Title"] = "Gestión de Clientes";
    var q = ViewBag.CurrentQuery as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var user = HttpContextAccessor.HttpContext?.User;
    bool isAdmin = user?.IsInRole("Admin") ?? false;
    bool isEmpleado = user?.IsInRole("Empleado") ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Gestión de Clientes</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Cliente
        </a>
    </div>

    <form method="get" asp-action="Index" class="mb-3 row g-2">
        <div class="col-auto">
            <input type="text" name="q" value="@q" class="form-control" placeholder="Buscar por NIT o nombre..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-list"></i> Lista de Clientes</h5>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h5 class="text-muted">No hay clientes registrados</h5>
                    <a asp-action="Crear" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Crear Primer Cliente
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>NIT</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Dirección</th>
                                <th>Estado</th>
                                @if (isAdmin)
                                {
                                    <th>Acciones</th>
                                }

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>@cliente.Id_Cliente</td>
                                    <td>@cliente.NIT</td>
                                    <td>@cliente.Nombre</td>
                                    <td>@cliente.Apellido</td>
                                    <td>@cliente.Direccion</td>
                                    <td>
                                        <span class="badge bg-@(cliente.Activo ? "success" : "danger")">
                                            @(cliente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Editar" asp-route-id="@cliente.Id_Cliente"
                                                class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div class="d-flex justify-content-between align-items-center">
                    <div>Mostrando página @currentPage de @totalPages | Total: @ViewBag.TotalItems</div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@q">‹</a>
                            </li>
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@q">›</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

