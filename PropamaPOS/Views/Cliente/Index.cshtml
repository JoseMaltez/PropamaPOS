@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model IEnumerable<PropamaPOS.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes";
    var q = ViewBag.CurrentQuery as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    var user = HttpContextAccessor.HttpContext?.User;
    bool isAdmin = user?.IsInRole("Admin") ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Gestión de Clientes</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Cliente
        </a>
    </div>

    <!-- Filtros -->
    <form method="get" class="card shadow-sm mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Buscar cliente</label>
                <input type="text" name="q" value="@q" class="form-control"
                       placeholder="Buscar por NIT, nombre, apellido o dirección..." />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Limpiar
                </a>
            </div>
        </div>
    </form>

    @await Html.PartialAsync("_AlertsPartial")

    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list"></i> Lista de Clientes</h5>
            <small>Total: @totalItems registros</small>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h5 class="text-muted">No hay clientes registrados o no coinciden con la búsqueda</h5>
                    <a asp-action="Crear" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Crear Primer Cliente
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>NIT</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Dirección</th>
                                @if (isAdmin)
                                {
                                    <th class="text-center">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>@cliente.Id_Cliente</td>
                                    <td>@cliente.NIT</td>
                                    <td>@cliente.Nombre</td>
                                    <td>@cliente.Apellido</td>
                                    <td>@cliente.Direccion</td>
                                    @if (isAdmin)
                                    {
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-action="Editar" asp-route-id="@cliente.Id_Cliente"
                                                   class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Eliminar" asp-route-id="@cliente.Id_Cliente"
                                                   class="btn btn-sm btn-outline-danger" title="Desactivar">
                                                    <i class="bi bi-person-x"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small>Mostrando página @currentPage de @totalPages — Total: @totalItems clientes</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(currentPage - 1)&q=@q">Anterior</a>
                                </li>
                            }
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i >= currentPage - 2 && i <= currentPage + 2)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&q=@q">@i</a>
                                    </li>
                                }
                            }
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?page=@(currentPage + 1)&q=@q">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>
