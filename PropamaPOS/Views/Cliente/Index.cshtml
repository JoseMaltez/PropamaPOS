﻿@using System.Security.Claims
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model IEnumerable<PropamaPOS.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes";
    var q = ViewBag.CurrentQuery as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    var user = HttpContextAccessor.HttpContext?.User;
    bool isAdmin = user?.IsInRole("Admin") ?? false;
}

<div class="container-fluid mt-4 client-fade-in">
    <!-- Header -->
    <div class="client-header">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="client-title mb-2">
                    <i class="bi bi-people-fill me-3"></i>Gestión de Clientes
                </h1>
                <p class="client-subtitle mb-0">
                    Administra la información de los clientes de tu negocio
                </p>
            </div>
            <div class="col-auto">
                <a asp-action="Crear" class="btn btn-warning btn-lg fw-bold">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Cliente
                </a>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="client-search-card">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Buscar cliente</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="q" value="@q" class="form-control border-start-0"
                               placeholder="Buscar por NIT, nombre, apellido o dirección..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search me-2"></i>Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_AlertsPartial")

    <!-- Tabla de Clientes -->
    <div class="client-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white">
                <i class="bi bi-list-ul me-2"></i>Lista de Clientes
            </h5>
            <span class="badge bg-warning text-dark fs-6">Total: @totalItems registros</span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="clients-empty-state">
                    <i class="bi bi-people clients-empty-icon"></i>
                    <h5 class="text-muted mb-3">No hay clientes registrados</h5>
                    <p class="text-muted mb-4">Comienza agregando tu primer cliente al sistema.</p>
                    <a asp-action="Crear" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Crear Primer Cliente
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover clients-table mb-0">
                        <thead>
                            <tr>
                                <th class="text-center">ID</th>
                                <th>NIT</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Dirección</th>
                                <th class="text-center">Estado</th>
                                @if (isAdmin)
                                {
                                    <th class="text-center">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td class="text-center fw-semibold">@cliente.Id_Cliente</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@cliente.NIT</span>
                                    </td>
                                    <td class="fw-semibold">@cliente.Nombre</td>
                                    <td>@cliente.Apellido</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(cliente.Direccion))
                                        {
                                            <span class="text-truncate d-inline-block" style="max-width: 200px;"
                                                  data-bs-toggle="tooltip" title="@cliente.Direccion">
                                                @cliente.Direccion
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin dirección</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="client-status-badge badge-status-@(cliente.Activo ? "active" : "inactive")">
                                            @(cliente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Editar" asp-route-id="@cliente.Id_Cliente"
                                                   class="btn btn-client-action btn-client-edit"
                                                   data-bs-toggle="tooltip" title="Editar cliente">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Eliminar" asp-route-id="@cliente.Id_Cliente"
                                                   class="btn btn-client-action btn-client-delete"
                                                   data-bs-toggle="tooltip" title="Desactivar cliente">
                                                    <i class="bi bi-person-x"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-transparent border-top-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Mostrando página @currentPage de @totalPages — Total: @totalItems clientes
                            </small>
                            <nav>
                                <ul class="pagination clients-pagination mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="?page=@(currentPage - 1)&q=@q">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i >= currentPage - 2 && i <= currentPage + 2)
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <a class="page-link" href="?page=@i&q=@q">@i</a>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link" href="?page=@(currentPage + 1)&q=@q">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}