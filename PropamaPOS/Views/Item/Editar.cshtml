@model PropamaPOS.Models.ViewModels.ItemViewModel
@{
    ViewData["Title"] = "Editar Producto o Servicio";
    var unidades = ViewBag.Unidades as List<PropamaPOS.Models.UnidadMedida> ?? new();
    bool esServicio = Model.IsServicio;
}

<div class="container mt-4 item-fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="item-card">
                <div class="card-header">
                    <h3 class="mb-0 text-center"><i class="bi bi-pencil-square me-2"></i>Editar Producto o Servicio</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Editar" method="post" id="itemForm" class="item-form">
                        @Html.HiddenFor(m => m.Id_Item)
                        <input type="hidden" asp-for="Codigo" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Información Básica -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="section-title mb-3"><i class="bi bi-info-circle me-2"></i>Información Básica</h5>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto o servicio" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Codigo" class="form-label">Código del producto/servicio</label>
                                <input asp-for="Codigo" class="form-control" readonly />
                                <span class="form-text text-muted">Este código es generado automáticamente y no puede modificarse.</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción (opcional)"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="Id_Categoria" class="form-label">Categoría</label>
                            <select asp-for="Id_Categoria" class="form-select" asp-items="ViewBag.Categorias" id="categoriaSelect" disabled="@(esServicio ? "disabled" : null)"></select>
                        </div>

                        <div class="mb-3" id="stockMinimoContainer" style="display:none;">
                            <label for="StockMinimo" class="form-label">Stock Mínimo</label>
                            <input asp-for="StockMinimo" class="form-control" type="number" min="0" step="1" />
                            <span asp-validation-for="StockMinimo" class="text-danger"></span>
                            <div class="form-text">Dejar en 0 si no aplica. No se aplica para servicios.</div>
                        </div>

                        <div class="form-check mb-4">
                            <input type="checkbox" class="form-check-input" id="IsServicio" name="IsServicio" value="true" @(esServicio ? "checked='checked'" : "") disabled="disabled" />
                            <label class="form-check-label" for="IsServicio">Es un servicio?</label>
                            <input type="hidden" name="IsServicio" value="@(esServicio.ToString().ToLower())" />
                        </div>

                        <hr />
                        <h5>Presentaciones y precios</h5>
                        <p class="text-muted small">Para servicios, solo se permite una unidad con cantidad 1 y precio editable.</p>

                        <div class="table-responsive">
                            <table class="table table-bordered presentaciones-table" id="presentacionesTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Unidad</th>
                                        <th>Cantidad</th>
                                        @if (esServicio)
                                        {
                                            <th class="col-precio">Precio Venta Sin Iva (Q)</th>
                                        }
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Presentaciones.Count; i++)
                                    {
                                        var p = Model.Presentaciones[i];
                                        <tr>
                                            <input type="hidden" name="Presentaciones[@i].Id_ItemPresentacion" value="@p.Id_ItemPresentacion" />
                                            <td>
                                                <select name="Presentaciones[@i].Id_UnidadMedida" class="form-select" required @(esServicio ? "disabled" : "")>
                                                    @foreach (var u in unidades)
                                                    {
                                                        <option value="@u.Id_UnidadMedida" selected="@(u.Id_UnidadMedida == p.Id_UnidadMedida ? "selected" : null)">@u.Nombre</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input name="Presentaciones[@i].Cantidad" value="@p.Cantidad" class="form-control" type="number" min="1" required @(esServicio ? "readonly" : "") />
                                            </td>

                                            @if (esServicio)
                                            {
                                                <td class="col-precio">
                                                    <input name="Presentaciones[@i].PrecioVenta"
                                                           value="@p.PrecioVenta"
                                                           class="form-control precio-input"
                                                           type="number"
                                                           step="0.01"
                                                           min="0"
                                                           required />
                                                </td>
                                            }

                                            <td>
                                                @if (!esServicio)
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm remove-row"><i class="bi bi-trash"></i></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!esServicio)
                        {
                            <div class="mb-3">
                                <button type="button" id="addPresentacion" class="btn btn-outline-primary">
                                    <i class="bi bi-plus"></i> Agregar presentación
                                </button>
                            </div>
                        }

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-2"></i> Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const unidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(unidades));
            const esServicio = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(esServicio));
            const stockMinimoContainer = document.getElementById('stockMinimoContainer');
            const tableBody = document.querySelector('#presentacionesTable tbody');
            const addBtn = document.getElementById('addPresentacion');
            const categoriaSelect = document.getElementById('categoriaSelect');
            const servicioNombre = "servicio";
            const isServicio = document.getElementById('IsServicio');

            // Configuración inicial basada en si es servicio o producto
            if (categoriaSelect && categoriaSelect.options.length > 0) {
                const first = categoriaSelect.options[0];
                if (first && first.value === "") first.disabled = true;
            }

            function hideServicioOption(hide) {
                Array.from(categoriaSelect.options).forEach(opt => {
                    const t = (opt.text || "").trim().toLowerCase();
                    if (t === servicioNombre) opt.hidden = hide;
                });
            }

            // Ocultar o mostrar opción de servicio según el tipo
            if (categoriaSelect) hideServicioOption(!esServicio);

            // Configuración para servicios
            if (esServicio) {
                if (addBtn) addBtn.disabled = true;
                const unidadSelect = tableBody.querySelector('select');
                const cantidadInput = tableBody.querySelector('input[name*=".Cantidad"]');
                const precioInput = tableBody.querySelector('.precio-input');

                if (unidadSelect) {
                    const unidad = unidades.find(u => u.Nombre && u.Nombre.toLowerCase() === "unidad");
                    if (unidad) unidadSelect.value = unidad.Id_UnidadMedida;
                    unidadSelect.setAttribute('disabled', 'disabled');
                }
                if (cantidadInput) {
                    cantidadInput.value = 1;
                    cantidadInput.setAttribute('readonly', 'readonly');
                }
                if (precioInput) precioInput.removeAttribute('readonly');

                // Remover botones de eliminar en servicios
                tableBody.querySelectorAll('.remove-row').forEach(b => b.remove());

                // Ocultar stock mínimo para servicios
                stockMinimoContainer.style.display = 'none';
            }
            // Configuración para productos
            else {
                // Ocultar columna de precio para productos
                document.querySelectorAll('.col-precio').forEach(td => td.style.display = 'none');

                // Mostrar stock mínimo para productos
                stockMinimoContainer.style.display = 'block';

                // Configurar botón para agregar presentaciones
                if (addBtn) {
                    let nextIndex = tableBody.querySelectorAll('tr').length;
                    addBtn.addEventListener('click', function () {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td>
                                <select name="Presentaciones[${nextIndex}].Id_UnidadMedida" class="form-select" required>
                                    <option value="">-- Seleccione --</option>
                                    ${unidades.map(u => `<option value="${u.Id_UnidadMedida}">${u.Nombre}</option>`).join('')}
                                </select>
                            </td>
                            <td>
                                <input name="Presentaciones[${nextIndex}].Cantidad" value="1" class="form-control" type="number" min="1" required />
                            </td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm remove-row"><i class="bi bi-trash"></i></button>
                            </td>
                        `;
                        tableBody.appendChild(tr);
                        nextIndex++;
                    });
                }

                // Configurar eliminación de filas
                tableBody.addEventListener('click', function (e) {
                    if (e.target && e.target.classList.contains('remove-row')) {
                        const tr = e.target.closest('tr');
                        // Solo permitir eliminar si hay más de una fila
                        if (tr && tableBody.querySelectorAll('tr').length > 1) {
                            tr.remove();
                            // Reindexar las filas restantes
                            reindexRows();
                        }
                    }
                });

                // Función para reindexar filas después de eliminar
                function reindexRows() {
                    const rows = tableBody.querySelectorAll('tr');
                    rows.forEach((row, index) => {
                        // Actualizar nombres de los inputs
                        const unidadSelect = row.querySelector('select');
                        const cantidadInput = row.querySelector('input[name*=".Cantidad"]');
                        const idHidden = row.querySelector('input[type="hidden"]');

                        if (unidadSelect) unidadSelect.name = `Presentaciones[${index}].Id_UnidadMedida`;
                        if (cantidadInput) cantidadInput.name = `Presentaciones[${index}].Cantidad`;
                        if (idHidden) idHidden.name = `Presentaciones[${index}].Id_ItemPresentacion`;
                    });
                }
            }

            // Validación del formulario
            document.getElementById('itemForm').addEventListener('submit', function(e){
                if (!categoriaSelect.value) {
                    e.preventDefault();
                    alert('Por favor seleccione una categoría válida.');
                    return false;
                }

                // Validar que los productos tengan al menos una presentación
                if (!esServicio && tableBody.querySelectorAll('tr').length === 0) {
                    e.preventDefault();
                    alert('Los productos deben tener al menos una presentación.');
                    return false;
                }
            });
        })();
    </script>
}