@model PropamaPOS.Models.ViewModels.ItemViewModel
@{
    ViewData["Title"] = "Editar Producto o Servicio";
    var unidades = ViewBag.Unidades as List<PropamaPOS.Models.UnidadMedida> ?? new();
    bool esServicio = Model.IsServicio;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Editar Producto o Servicio</h3>

                    <form asp-action="Editar" method="post">
                        @Html.HiddenFor(m => m.Id_Item)
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto o servicio" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Codigo" class="form-label">Código (opcional)</label>
                                <input asp-for="Codigo" class="form-control" placeholder="SKU / Código" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Id_Categoria" class="form-label">Categoría</label>
                            <select asp-for="Id_Categoria" class="form-select" asp-items="ViewBag.Categorias" id="categoriaSelect" disabled="@(esServicio ? "disabled" : null)">
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                        </div>

                        <div class="form-check mb-4">
                            <input type="checkbox" id="IsServicio" class="form-check-input" @(esServicio ? "checked" : "") disabled>
                            <label class="form-check-label" for="IsServicio">Es un servicio</label>
                        </div>

                        <hr />
                        <h5>Presentaciones y precios</h5>

                        <table class="table" id="presentacionesTable">
                            <thead>
                                <tr>
                                    <th>Unidad</th>
                                    <th>Cantidad</th>
                                    @if (esServicio)
                                    {
                                        <th>Precio Venta (Q)</th>
                                    }
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Presentaciones.Count; i++)
                                {
                                    var p = Model.Presentaciones[i];
                                    <tr>
                                        <input type="hidden" name="Presentaciones[@i].Id_ItemPresentacion" value="@p.Id_ItemPresentacion" />
                                        <td>
                                            <select name="Presentaciones[@i].Id_UnidadMedida" class="form-select" @(esServicio ? "disabled" : "")>
                                                @foreach (var u in unidades)
                                                {
                                                    <option value="@u.Id_UnidadMedida" selected="@(u.Id_UnidadMedida == p.Id_UnidadMedida ? "selected" : null)">@u.Nombre</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input name="Presentaciones[@i].Cantidad" value="@p.Cantidad" class="form-control" type="number" min="1" @(esServicio ? "readonly" : "") />
                                        </td>
                                        @if (esServicio)
                                        {
                                            <td><input name="Presentaciones[@i].PrecioVenta" value="@p.PrecioVenta" class="form-control" type="number" step="0.01" /></td>
                                        }
                                        <td>
                                            @if (!esServicio)
                                            {
                                                <button type="button" class="btn btn-danger btn-sm remove-row">Eliminar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (!esServicio)
                        {
                            <div class="mb-3">
                                <button type="button" id="addPresentacion" class="btn btn-outline-secondary">
                                    <i class="bi bi-plus"></i> Agregar presentación
                                </button>
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Volver</a>
                            <button type="submit" class="btn btn-success">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const categoriaSelect = document.getElementById('categoriaSelect');
            const first = categoriaSelect.options[0];
            if (first && first.value === "") first.disabled = true;

            const servicioNombre = "Servicio";
            const esServicio = @esServicio.ToString().ToLower() === "true";
            Array.from(categoriaSelect.options).forEach(opt => {
                const t = (opt.text || "").trim().toLowerCase();
                if (t === servicioNombre.toLowerCase()) opt.hidden = !esServicio;
            });
        })();
    </script>
}
