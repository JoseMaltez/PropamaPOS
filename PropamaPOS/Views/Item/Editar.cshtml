@model PropamaPOS.Models.ViewModels.ItemViewModel
@{
    ViewData["Title"] = "Editar Producto o Servicio";
    var unidades = ViewBag.Unidades as List<PropamaPOS.Models.UnidadMedida> ?? new();
    bool esServicio = Model.IsServicio;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Editar Producto o Servicio</h3>

                    <form asp-action="Editar" method="post" id="itemForm">
                        @Html.HiddenFor(m => m.Id_Item)
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto o servicio" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Codigo" class="form-label">Código (opcional)</label>
                                <input asp-for="Codigo" class="form-control" placeholder="SKU / Código" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción (opcional)"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="Id_Categoria" class="form-label">Categoría</label>
                            <select asp-for="Id_Categoria" class="form-select" asp-items="ViewBag.Categorias" id="categoriaSelect">
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                        </div>

                        <!-- ✅ Checkbox bloqueado, sin C# en atributos -->
                        <div class="form-check mb-4">
                            <input type="checkbox" class="form-check-input" id="IsServicio" name="IsServicio" value="true" @(esServicio ? "checked='checked'" : "") disabled="disabled" />
                            <label class="form-check-label" for="IsServicio">Es un servicio (no se controla stock ni compras)</label>
                            <input type="hidden" name="IsServicio" value="@(esServicio.ToString().ToLower())" />
                        </div>

                        <hr />
                        <h5>Presentaciones y precios</h5>
                        <p class="text-muted small">Para servicios, puede modificar el precio manualmente.</p>

                        <table class="table" id="presentacionesTable">
                            <thead>
                                <tr>
                                    <th>Unidad</th>
                                    <th>Cantidad</th>
                                    <th class="col-precio">Precio Venta (Q)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Presentaciones.Count; i++)
                                {
                                    var presentacion = Model.Presentaciones[i];
                                    <tr>
                                        <input type="hidden" name="Presentaciones[@i].Id_ItemPresentacion" value="@presentacion.Id_ItemPresentacion" />
                                        <td>
                                            <select name="Presentaciones[@i].Id_UnidadMedida" class="form-select" required>
                                                <option value="">-- Seleccione --</option>
                                                @foreach (var u in unidades)
                                                {
                                                    if (u.Id_UnidadMedida == presentacion.Id_UnidadMedida)
                                                    {
                                                        @:
                                                        <option value="@u.Id_UnidadMedida" selected="selected">@u.Nombre</option>
                                                    }
                                                    else
                                                    {
                                                        @:
                                                        <option value="@u.Id_UnidadMedida">@u.Nombre</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input name="Presentaciones[@i].Cantidad" value="@presentacion.Cantidad" class="form-control" type="number" min="1" required />
                                        </td>
                                        <td class="col-precio">
                                            <input name="Presentaciones[@i].PrecioVenta" value="@presentacion.PrecioVenta" class="form-control precio-input" type="number" step="0.01" min="0" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-danger btn-sm remove-row">Eliminar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="mb-3">
                            <button type="button" id="addPresentacion" class="btn btn-outline-secondary"><i class="bi bi-plus"></i> Agregar presentación</button>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                            <button type="submit" class="btn btn-success">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    @using System.Text.Json
    <script>
        (function(){
            const unidades = @Html.Raw(JsonSerializer.Serialize(unidades));
            const tableBody = document.querySelector('#presentacionesTable tbody');
            const isServicio = document.getElementById('IsServicio');
            const categoriaSelect = document.getElementById('categoriaSelect');
            const servicioNombre = "Servicio";

            function togglePrecioColumn() {
                const show = isServicio.checked;
                document.querySelectorAll('.col-precio').forEach(td => td.style.display = show ? '' : 'none');
                if (!show) document.querySelectorAll('.precio-input').forEach(i => i.value = 0);
            }

            function toggleCategoria() {
                const opciones = Array.from(categoriaSelect.options);
                const catServicio = opciones.find(o => o.text.trim().toLowerCase() === servicioNombre.toLowerCase());
                if (isServicio.checked) {
                    if (catServicio) {
                        categoriaSelect.value = catServicio.value;
                        categoriaSelect.setAttribute('disabled', 'disabled');
                    }
                } else {
                    categoriaSelect.removeAttribute('disabled');
                    if (catServicio) catServicio.style.display = 'none';
                }
            }

            togglePrecioColumn();
            toggleCategoria();
        })();
    </script>
}
