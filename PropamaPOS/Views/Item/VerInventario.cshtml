@model IEnumerable<PropamaPOS.Models.Item>
@{
    ViewData["Title"] = "Inventario - Consulta";
    var categorias = ViewBag.Categorias as List<PropamaPOS.Models.Categoria> ?? new();
    var currentCategoria = ViewBag.CurrentCategoria as int?;
    var currentQuery = ViewBag.CurrentQuery as string;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;
    var iva = ViewBag.IVA as decimal? ?? 0.12m;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-box-seam"></i> Consulta de Productos y Servicios</h4>
        </div>

        <div class="card-body">
            <!-- FILTROS -->
            <form method="get" class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="text" name="q" value="@currentQuery" class="form-control" placeholder="Buscar por nombre o código..." />
                </div>
                <div class="col-md-4">
                    <select name="categoriaId" class="form-select">
                        <option value="">-- Todas las categorías --</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id_Categoria" selected="@(currentCategoria.HasValue && currentCategoria.Value == c.Id_Categoria ? "selected" : null)">
                                @c.Nombre
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit"><i class="bi bi-search"></i> Buscar</button>
                </div>
            </form>

            <!-- TABLA DE RESULTADOS -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Código</th>
                            <th>Categoría</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Stock Min.</th>
                            <th>Presentaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">No se encontraron productos</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var i in Model)
                            {
                                <tr>
                                    <td>@i.Nombre</td>
                                    <td>@i.Codigo</td>
                                    <td>@i.Categoria?.Nombre</td>
                                    <td class="text-center">@i.Stock</td>
                                    <td class="text-center">@(i.StockMinimo ?? 0)</td>
                                    <td>
                                        @foreach (var p in i.Presentaciones.Where(pp => pp.Activo))
                                        {
                                            var precioSinIVA = p.PrecioVenta;
                                            var precioConIVA = Math.Round(precioSinIVA * (1 + iva), 2);
                                            <div>
                                                <span class="fw-semibold">@p.Cantidad @p.UnidadMedida?.Nombre</span>
                                                <br />
                                                <small class="text-muted">
                                                    Precio sin IVA: @($"Q{precioSinIVA:F2}")<br />
                                                    Precio con IVA: <span class="text-success fw-bold">@($"Q{precioConIVA:F2}")</span>
                                                </small>
                                            </div>
                                            <hr class="my-1" />
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINACIÓN -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    <small>Mostrando página @currentPage de @totalPages — Total: @totalItems ítems</small>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(currentPage - 1)&q=@currentQuery&categoriaId=@currentCategoria">Anterior</a>
                            </li>
                        }

                        @for (int i = 1; i <= (int)totalPages; i++)
                        {
                            if (i >= (int)currentPage - 2 && i <= (int)currentPage + 2)
                            {
                                <li class="page-item @(i == (int)currentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i&q=@currentQuery&categoriaId=@currentCategoria">@i</a>
                                </li>
                            }
                        }

                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(currentPage + 1)&q=@currentQuery&categoriaId=@currentCategoria">Siguiente</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
