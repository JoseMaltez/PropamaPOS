    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<PropamaPOS.Models.Item>
@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-box-seam"></i> Gestión de Productos</h2>
        <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Producto</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <h5 class="text-muted">No hay productos registrados</h5>
                    <a asp-action="Crear" class="btn btn-primary mt-2">Crear Producto</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Código</th>
                                <th>Presentaciones / Precio (Q)</th>
                                <th>Stock</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id_Item</td>
                                    <td>@item.Nombre</td>
                                    <td>@item.Codigo</td>
                                    <td>
                                        @foreach (var p in item.Presentaciones)
                                        {
                                            <div>
                                                @($"{p.Cantidad} x {p.UnidadMedida?.Nombre} — Q{p.PrecioVenta:0.00}")
                                            </div>
                                        }
                                    </td>
                                    <td>@item.Stock</td>
                                    <td>
                                        <span class="badge bg-@(item.Activo ? "success" : "danger")">
                                            @(item.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Editar" asp-route-id="@item.Id_Item" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
                                            <a asp-action="Eliminar" asp-route-id="@item.Id_Item" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>