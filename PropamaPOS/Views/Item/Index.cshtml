@model IEnumerable<PropamaPOS.Models.Item>
@{
    ViewData["Title"] = "Gestión de Productos y Servicios";
    var categorias = ViewBag.Categorias as List<PropamaPOS.Models.Categoria> ?? new();
    var currentCategoria = ViewBag.CurrentCategoria as int?;
    var currentQuery = ViewBag.CurrentQuery as string;
    var bajoStock = ViewBag.CurrentBajoStock as bool?;
    var esServicio = ViewBag.CurrentEsServicio as bool?;
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;
    var iva = ViewBag.IVA as decimal? ?? 0.12m;
}

<div class="container mt-4 item-fade-in">
    <!-- Header Mejorado -->
    <div class="item-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="item-title"><i class="bi bi-box-seam me-3"></i>Gestión de Productos y Servicios</h1>
                <p class="item-subtitle">Administra todos los productos y servicios del sistema</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Crear" class="btn btn-warning btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Item
                </a>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertsPartial")

    <!-- Filtros Mejorados -->
    <div class="item-search-card">
        <div class="card-body">
            <h5 class="card-title mb-4"><i class="bi bi-funnel me-2"></i>Filtros de Búsqueda</h5>
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Buscar</label>
                    <input type="text" name="q" value="@currentQuery" class="form-control" placeholder="Nombre o código..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Categoría</label>
                    <select name="categoriaId" class="form-select">
                        <option value="">Todas las categorías</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id_Categoria" selected="@(currentCategoria == c.Id_Categoria)">@c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Tipo</label>
                    <select name="esServicio" class="form-select">
                        <option value="">Todos</option>
                        <option value="false" selected="@(esServicio == false)">Producto</option>
                        <option value="true" selected="@(esServicio == true)">Servicio</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-3">
                        <input type="checkbox" class="form-check-input" id="chkBajoStock" name="bajoStock" value="true" @(bajoStock == true ? "checked" : null) />
                        <label class="form-check-label fw-semibold" for="chkBajoStock">Bajo stock</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-2"></i>Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-arrow-clockwise me-2"></i>Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Mejorada -->
    <div class="item-card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Lista de Items</h5>
                <span class="badge bg-warning text-dark">Total: @totalItems registros</span>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="items-empty-state">
                    <i class="bi bi-box items-empty-icon"></i>
                    <h5 class="text-muted">No se encontraron resultados</h5>
                    <p class="text-muted">Intenta ajustar los filtros de búsqueda o crear un nuevo item.</p>
                    <a asp-action="Crear" class="btn btn-primary mt-3">
                        <i class="bi bi-plus-circle me-2"></i>Crear Primer Item
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table items-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Stock Mín.</th>
                                <th>Presentaciones</th>
                                <th class="text-center">Tipo</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model)
                            {
                                <tr class="@(i.Stock <= (i.StockMinimo ?? 0) && !i.IsServicio ? "table-warning" : "")">
                                    <td class="fw-semibold">@i.Codigo</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi @(i.IsServicio ? "bi-tools" : "bi-box") me-2 text-primary"></i>
                                            <span>@i.Nombre</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(i.Descripcion))
                                        {
                                            <small class="text-muted d-block">@i.Descripcion</small>
                                        }
                                    </td>
                                    <td>@i.Categoria?.Nombre</td>
                                    <td class="text-center">
                                        @if (i.IsServicio)
                                        {
                                            <span class="stock-na">N/A</span>
                                        }
                                        else
                                        {
                                            <span class="@(i.Stock <= (i.StockMinimo ?? 0) ? "stock-low" : "stock-adequate")">
                                                @i.Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">@(i.StockMinimo?.ToString() ?? "-")</td>
                                    <td>
                                        @foreach (var p in i.Presentaciones.Where(pp => pp.Activo))
                                        {
                                            var sinIva = p.PrecioVenta;
                                            var conIva = Math.Round(sinIva * (1 + iva), 2);
                                            <div class="mb-2 p-2 bg-light rounded">
                                                <strong class="d-block">@p.Cantidad @p.UnidadMedida?.Nombre</strong>
                                                <div class="precio-sin-iva">Sin IVA: Q@(sinIva.ToString("F2"))</div>
                                                <div class="precio-con-iva">Con IVA: Q@(conIva.ToString("F2"))</div>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="item-type-badge @(i.IsServicio ? "badge-type-service" : "badge-type-product")">
                                            @(i.IsServicio ? "Servicio" : "Producto")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Editar" asp-route-id="@i.Id_Item"
                                               class="btn btn-item-edit"
                                               data-bs-toggle="tooltip"
                                               title="Editar item">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Eliminar" asp-route-id="@i.Id_Item"
                                               class="btn btn-item-delete"
                                               data-bs-toggle="tooltip"
                                               title="Eliminar item">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación Mejorada -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div>
                            <small class="text-muted">
                                Mostrando página @currentPage de @totalPages — Total: @totalItems items
                            </small>
                        </div>
                        <nav>
                            <ul class="pagination items-pagination mb-0">
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(currentPage - 1)&q=@currentQuery&categoriaId=@currentCategoria&bajoStock=@bajoStock&esServicio=@esServicio">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i >= currentPage - 2 && i <= currentPage + 2)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" href="?page=@i&q=@currentQuery&categoriaId=@currentCategoria&bajoStock=@bajoStock&esServicio=@esServicio">@i</a>
                                        </li>
                                    }
                                }
                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(currentPage + 1)&q=@currentQuery&categoriaId=@currentCategoria&bajoStock=@bajoStock&esServicio=@esServicio">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Inicializar tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}