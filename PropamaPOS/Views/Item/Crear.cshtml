@model PropamaPOS.Models.ViewModels.ItemViewModel
@{
    ViewData["Title"] = "Crear Producto o Servicio";
    var unidades = ViewBag.Unidades as List<PropamaPOS.Models.UnidadMedida> ?? new();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Crear Producto o Servicio</h3>

                    <form asp-action="Crear" method="post" id="itemForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto o servicio" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Codigo" class="form-label">Código (opcional)</label>
                                <input asp-for="Codigo" class="form-control" placeholder="SKU / Código" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción (opcional)"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Id_Categoria" class="form-label">Categoría <span class="text-danger">*</span></label>
                            <!-- Nota: eliminé el <option> manual para evitar "-- Seleccionar --" -->
                            <select asp-for="Id_Categoria" class="form-select" asp-items="ViewBag.Categorias" id="categoriaSelect"></select>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsServicio" class="form-check-input" id="IsServicio" />
                            <label class="form-check-label" for="IsServicio">Es un servicio (no se controla stock ni compras)</label>
                        </div>

                        <hr />
                        <h5>Presentaciones y precios</h5>
                        <p class="text-muted small">Para productos, el precio se calcula automáticamente. Para servicios, puede definirse manualmente.</p>

                        <table class="table" id="presentacionesTable">
                            <thead>
                                <tr>
                                    <th>Unidad</th>
                                    <th>Cantidad</th>
                                    <th class="col-precio">Precio Venta (Q)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>

                        <div class="mb-3">
                            <button type="button" id="addPresentacion" class="btn btn-outline-secondary">
                                <i class="bi bi-plus"></i> Agregar presentación
                            </button>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                            <button type="submit" class="btn btn-success">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function(){
            // Datos pasados desde Razor
            const unidades = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unidades));
            const tableBody = document.querySelector('#presentacionesTable tbody');
            const isServicio = document.getElementById('IsServicio');
            const categoriaSelect = document.getElementById('categoriaSelect');
            const addBtn = document.getElementById('addPresentacion');
            const servicioNombre = "servicio";
            const unidadNombre = "unidad";
            let nextIndex = 0;

            // Templates
            function createRow(index, presetUnidadId, presetCantidad, showPrecio, removable = true) {
                // If showPrecio is false, still include the input but rely on CSS to hide the column; keep it to maintain form model consistency
                const precioValue = (typeof presetCantidad === 'object' && presetCantidad !== null) ? '' : (arguments[2] ?? '');
                const tr = document.createElement('tr');
                tr.dataset.index = index;
                tr.innerHTML = `
                    <td>
                        <select name="Presentaciones[${index}].Id_UnidadMedida" class="form-select unidad-select" required>
                            <option value="">-- Seleccione --</option>
                            ${unidades.map(u => `<option value="${u.Id_UnidadMedida}">${u.Nombre}</option>`).join('')}
                        </select>
                    </td>
                    <td>
                        <input name="Presentaciones[${index}].Cantidad" value="${presetCantidad ?? 1}" class="form-control cantidad-input" type="number" min="1" required />
                    </td>
                    <td class="col-precio">
                        <input name="Presentaciones[${index}].PrecioVenta" value="${presetPrecioToString(arguments[2])}" class="form-control precio-input" type="number" step="0.01" min="0" />
                    </td>
                    <td>${removable ? '<button type="button" class="btn btn-danger btn-sm remove-row">Eliminar</button>' : ''}</td>
                `;
                if (presetUnidadId) tr.querySelector('.unidad-select').value = presetUnidadId;
                return tr;
            }

            function presetPrecioToString(v) {
                if (v === undefined || v === null) return '';
                return v;
            }

            function addRow(presetUnidadId, presetCantidad, presetPrecio, removable = true) {
                tableBody.appendChild(createRow(nextIndex++, presetUnidadId, presetCantidad, presetPrecio, removable));
                updatePrecioVisibility();
            }

            function clearRows() {
                tableBody.innerHTML = '';
                nextIndex = 0;
            }

            function updatePrecioVisibility() {
                const show = isServicio.checked;
                document.querySelectorAll('.col-precio').forEach(td => td.style.display = show ? '' : 'none');
                if (!show) {
                    document.querySelectorAll('.precio-input').forEach(i => i.value = 0);
                }
            }

            // Helpers categoria
            function findServicioOption() {
                return Array.from(categoriaSelect.options).find(o => (o.text || '').trim().toLowerCase() === servicioNombre);
            }
            function hideServicioOption(hide) {
                Array.from(categoriaSelect.options).forEach(o => {
                    if ((o.text || '').trim().toLowerCase() === servicioNombre) {
                        o.hidden = hide;
                    }
                });
            }

            function findUnidadId() {
                const u = unidades.find(x => x.Nombre && x.Nombre.toLowerCase() === unidadNombre);
                return u ? u.Id_UnidadMedida : (unidades[0] ? unidades[0].Id_UnidadMedida : 0);
            }

            // Add button behavior (always attach, but enable/disable according to mode)
            if (addBtn) {
                addBtn.addEventListener('click', function(){
                    // Only allow adding if not service
                    if (isServicio.checked) return;
                    addRow(null, 1, 0, true);
                });
            }

            // Remove row
            tableBody.addEventListener('click', function(e){
                if (e.target && e.target.matches('.remove-row')) {
                    e.target.closest('tr').remove();
                }
            });

            // Service ON
            function applyServiceMode() {
                const servOpt = findServicioOption();
                if (servOpt) {
                    categoriaSelect.value = servOpt.value;
                }
                categoriaSelect.setAttribute('disabled','disabled');
                hideServicioOption(false); // show servicio while checked
                addBtn.disabled = true;

                // create single locked row
                clearRows();
                const unidadId = findUnidadId();
                addRow(unidadId, 1, '', false);

                const row = tableBody.querySelector('tr');
                if (row) {
                    row.querySelector('.unidad-select').setAttribute('disabled','disabled');
                    const cantidad = row.querySelector('.cantidad-input');
                    cantidad.value = 1;
                    cantidad.setAttribute('readonly','readonly');
                    // precio visible and editable — leave as is
                }

                updatePrecioVisibility();
            }

            // Service OFF
            function removeServiceMode() {
                // un-block category and hide servicio option
                categoriaSelect.removeAttribute('disabled');
                hideServicioOption(true);
                addBtn.disabled = false;

                // clear the single service row so user can add multiple presentations
                clearRows();
                updatePrecioVisibility();
            }

            // Initialize UI state on load
            (function init() {
                // Hide servicio by default (unless checked)
                hideServicioOption(true);

                // If the select has no option selected (rare) choose first real option
                if (!categoriaSelect.value && categoriaSelect.options.length > 0) {
                    // set to first non-hidden option
                    const first = Array.from(categoriaSelect.options).find(o => !o.hidden);
                    if (first) categoriaSelect.value = first.value;
                }

                // If checkbox is present we wire change
                if (isServicio) {
                    isServicio.addEventListener('change', function(){
                        if (isServicio.checked) applyServiceMode();
                        else removeServiceMode();
                    });

                    // initialize according to current state
                    if (isServicio.checked) {
                        applyServiceMode();
                    } else {
                        removeServiceMode();
                    }
                } else {
                    // fallback — show/hide price column depending on presence of checkbox
                    updatePrecioVisibility();
                }
            })();

            // Prevent submitting with invalid category (bonus check) — since we removed the empty option this is mostly safety
            document.getElementById('itemForm').addEventListener('submit', function(e){
                if (!categoriaSelect.value) {
                    e.preventDefault();
                    alert('Por favor seleccione una categoría válida.');
                    return false;
                }
            });

        })();
    </script>
}