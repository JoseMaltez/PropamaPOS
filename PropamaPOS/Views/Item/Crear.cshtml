@model PropamaPOS.Models.ViewModels.ItemViewModel
@{
    ViewData["Title"] = "Crear Producto o Servicio";
    var unidades = ViewBag.Unidades as List<PropamaPOS.Models.UnidadMedida> ?? new();
    var proveedores = ViewBag.Proveedores as List<PropamaPOS.Models.Proveedor> ?? new();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Crear Producto o Servicio</h3>

                    <form asp-action="Crear" method="post" id="itemForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto o servicio" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Codigo" class="form-label">Código (opcional)</label>
                                <input asp-for="Codigo" class="form-control" placeholder="SKU / Código" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción (opcional)"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Id_Categoria" class="form-label">Categoría <span class="text-danger">*</span></label>
                            <select asp-for="Id_Categoria" class="form-select" asp-items="ViewBag.Categorias">
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                        </div>

                        <!-- NUEVO: Checkbox para indicar si es servicio -->
                        <div class="form-check mb-4">
                            <input asp-for="IsServicio" class="form-check-input" id="IsServicio" />
                            <label class="form-check-label" for="IsServicio">Es un servicio (no se controla stock ni compras)</label>
                        </div>

                        <hr />
                        <h5>Presentaciones y precios</h5>
                        <p class="text-muted small">Para productos, ingrese las presentaciones. Para servicios, agregue una sola presentación (por unidad) y defina el precio manualmente.</p>

                        <table class="table" id="presentacionesTable">
                            <thead>
                                <tr>
                                    <th>Unidad</th>
                                    <th>Cantidad</th>
                                    <th>Precio Venta (Q)</th> <!-- NUEVO -->
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Presentaciones.Count; i++)
                                {
                                    <tr>
                                        <input type="hidden" name="Presentaciones[@i].Id_ItemPresentacion" value="@Model.Presentaciones[i].Id_ItemPresentacion" />
                                        <td>
                                            <select name="Presentaciones[@i].Id_UnidadMedida" class="form-select" required>
                                                <option value="">-- Seleccione --</option>
                                                @foreach (var u in unidades)
                                                {
                                                    var selected = u.Id_UnidadMedida == Model.Presentaciones[i].Id_UnidadMedida ? "selected=\"selected\"" : "";
                                                    @:<option value="@u.Id_UnidadMedida" @Html.Raw(selected)>@u.Nombre</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input name="Presentaciones[@i].Cantidad" value="@Model.Presentaciones[i].Cantidad" class="form-control" type="number" min="1" required />
                                        </td>
                                        <td>
                                            <input name="Presentaciones[@i].PrecioVenta" value="@Model.Presentaciones[i].PrecioVenta" class="form-control precio-input" type="number" step="0.01" min="0" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-danger btn-sm remove-row">Eliminar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="mb-3">
                            <button type="button" id="addPresentacion" class="btn btn-outline-secondary"><i class="bi bi-plus"></i> Agregar presentación</button>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                            <button type="submit" class="btn btn-success">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (function(){
            const unidades = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(unidades));
            const tableBody = document.querySelector('#presentacionesTable tbody');
            const isServicio = document.getElementById('IsServicio');

            function createRow(index){
                const tr = document.createElement('tr');

                // Unidad
                const tdUnidad = document.createElement('td');
                const select = document.createElement('select');
                select.name = `Presentaciones[${index}].Id_UnidadMedida`;
                select.classList.add('form-select');
                const optDefault = document.createElement('option');
                optDefault.value = '';
                optDefault.text = '-- Seleccione --';
                select.appendChild(optDefault);
                unidades.forEach(u => {
                    const o = document.createElement('option');
                    o.value = u.Id_UnidadMedida;
                    o.text = u.Nombre;
                    select.appendChild(o);
                });
                tdUnidad.appendChild(select);
                tr.appendChild(tdUnidad);

                // Cantidad
                const tdCant = document.createElement('td');
                const inCant = document.createElement('input');
                inCant.name = `Presentaciones[${index}].Cantidad`;
                inCant.value = 1;
                inCant.classList.add('form-control');
                inCant.type = 'number';
                inCant.min = 1;
                tdCant.appendChild(inCant);
                tr.appendChild(tdCant);

                // Precio venta
                const tdPrecio = document.createElement('td');
                const inPrecio = document.createElement('input');
                inPrecio.name = `Presentaciones[${index}].PrecioVenta`;
                inPrecio.type = 'number';
                inPrecio.classList.add('form-control', 'precio-input');
                inPrecio.step = '0.01';
                inPrecio.min = '0';
                tdPrecio.appendChild(inPrecio);
                tr.appendChild(tdPrecio);

                // Eliminar
                const tdBtn = document.createElement('td');
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-danger btn-sm remove-row';
                btn.innerText = 'Eliminar';
                tdBtn.appendChild(btn);
                tr.appendChild(tdBtn);

                return tr;
            }

            let nextIndex = @Model.Presentaciones.Count;

            document.getElementById('addPresentacion').addEventListener('click', function(){
                const row = createRow(nextIndex++);
                tableBody.appendChild(row);
            });

            tableBody.addEventListener('click', function(e){
                if(e.target && e.target.matches('.remove-row')){
                    e.target.closest('tr').remove();
                }
            });

            // mostrar alerta informativa
            isServicio.addEventListener('change', function(){
                if (this.checked) {
                    alert("Este ítem se guardará como servicio. No se controlará stock ni se podrá comprar.");
                }
            });
        })();
    </script>
}
