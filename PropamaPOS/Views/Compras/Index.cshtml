@model IEnumerable<PropamaPOS.Models.Compra>
@{
    ViewData["Title"] = "Historial de Compras";
    string q = ViewBag.CurrentQuery as string ?? "";
    var estado = ViewBag.CurrentEstado as PropamaPOS.Models.CompraEstado?;
    string desde = ViewBag.Desde as string;
    string hasta = ViewBag.Hasta as string;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-cart-check fs-4 me-3"></i>
                            <h4 class="mb-0 fw-bold">Historial de Compras</h4>
                        </div>
                        <a asp-action="Crear" class="btn btn-light d-flex align-items-center">
                            <i class="bi bi-plus-circle me-2"></i> Nueva Compra
                        </a>
                    </div>
                </div>
                @await Html.PartialAsync("_AlertsPartial")
                <div class="card-body p-4">
                    <!-- Filtros -->
                    <form method="get" class="card shadow-sm mb-4 p-4">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark">N° Compra</label>
                                <input type="text" name="numero" value="@ViewBag.Numero" class="form-control" placeholder="Ej: CMP-000045" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark">Proveedor</label>
                                <input type="text" name="proveedor" value="@ViewBag.Proveedor" class="form-control" placeholder="Nombre del proveedor" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark">Empleado</label>
                                <input type="text" name="empleado" value="@ViewBag.Empleado" class="form-control" placeholder="Nombre del empleado" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark">Estado</label>
                                <select name="estado" class="form-select">
                                    <option value="">Todos</option>
                                    @foreach (var e in Enum.GetValues(typeof(PropamaPOS.Models.CompraEstado)))
                                    {
                                        <option value="@((int)e)" selected="@(ViewBag.CurrentEstado != null && ViewBag.CurrentEstado == (PropamaPOS.Models.CompraEstado)e)">
                                            @e
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 align-items-end mt-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark">Desde</label>
                                <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark">Hasta</label>
                                <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" />
                            </div>
                            <div class="col-md-6 d-flex gap-2 align-items-end">
                                <button type="submit" class="btn btn-primary flex-fill d-flex align-items-center justify-content-center">
                                    <i class="bi bi-search me-2"></i> Buscar
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary flex-fill d-flex align-items-center justify-content-center">
                                    <i class="bi bi-x-circle me-2"></i> Limpiar
                                </a>
                            </div>
                        </div>
                    </form>

                    <!-- Información de resultados -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-dark mb-0">
                            <i class="bi bi-list-check me-2"></i>Resultados
                        </h5>
                        <small class="text-muted">Total: @totalItems registros</small>
                    </div>

                    <!-- Tabla de Compras -->
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-basket display-4 text-muted mb-3"></i>
                            <h5>No se encontraron compras con los filtros aplicados.</h5>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 ps-4">Número</th>
                                        <th class="border-0">Fecha</th>
                                        <th class="border-0">Proveedor</th>
                                        <th class="border-0">Empleado</th>
                                        <th class="border-0 text-center">Líneas</th>
                                        <th class="border-0 text-end">Total</th>
                                        <th class="border-0 text-center">Estado</th>
                                        <th class="border-0 text-center pe-4">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var compra in Model)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-primary">@compra.NumeroCompra</div>
                                            </td>
                                            <td>
                                                <span class="text-muted">@compra.Fecha.ToString("g")</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@(compra.Proveedor?.Nombre ?? "-")</div>
                                            </td>
                                            <td>
                                                <span class="text-muted">@(compra.Empleado?.Nombre + " " + compra.Empleado.Apellido ?? compra.CreadoPor ?? "-")</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark">@(compra.Detalles?.Count ?? 0)</span>
                                            </td>
                                            <td class="text-end fw-bold text-success">Q@(compra.Total.ToString("F2"))</td>
                                            <td class="text-center">
                                                <span class="badge bg-@(compra.Estado == PropamaPOS.Models.CompraEstado.Borrador ? "secondary" :
                                                                                                            compra.Estado == PropamaPOS.Models.CompraEstado.Pendiente ? "warning" :
                                                                                                            compra.Estado == PropamaPOS.Models.CompraEstado.Cancelada ? "danger" : "success")">
                                            @compra.Estado
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-1 acciones-compras">
                                            @if (compra.Estado == PropamaPOS.Models.CompraEstado.Borrador)
                                                    {
                                                        <a asp-action="Editar" asp-route-id="@compra.Id_Compra"
                                                           class="btn btn-outline-primary btn-sm btn-accion"
                                                           data-bs-toggle="tooltip" title="Editar">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <form asp-action="MarcarPendiente" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@compra.Id_Compra" />
                                                            <button type="submit" class="btn btn-outline-info btn-sm btn-accion"
                                                                    data-bs-toggle="tooltip" title="Marcar como Pendiente">
                                                                <i class="bi bi-send"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-action="Cancelar" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@compra.Id_Compra" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-accion"
                                                                    data-bs-toggle="tooltip" title="Cancelar Compra">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else if (compra.Estado == PropamaPOS.Models.CompraEstado.Pendiente)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@compra.Id_Compra"
                                                           class="btn btn-outline-secondary btn-sm btn-accion"
                                                           data-bs-toggle="tooltip" title="Ver Detalles">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <form asp-action="MarcarRecibida" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@compra.Id_Compra" />
                                                            <button type="submit" class="btn btn-outline-success btn-sm btn-accion"
                                                                    data-bs-toggle="tooltip" title="Marcar como Recibida">
                                                                <i class="bi bi-box-seam"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-action="Cancelar" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@compra.Id_Compra" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-accion"
                                                                    data-bs-toggle="tooltip" title="Cancelar Compra">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="Details" asp-route-id="@compra.Id_Compra"
                                                           class="btn btn-outline-secondary btn-sm btn-accion"
                                                           data-bs-toggle="tooltip" title="Ver Detalles">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <small class="text-muted">Mostrando página @currentPage de @totalPages — Total: @totalItems registros</small>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    @if (currentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="?page=@(currentPage - 1)&q=@q&estado=@estado&desde=@desde&hasta=@hasta">Anterior</a>
                                        </li>
                                    }
                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        if (i >= currentPage - 2 && i <= currentPage + 2)
                                        {
                                            <li class="page-item @(i == currentPage ? "active" : "")">
                                                <a class="page-link" href="?page=@i&q=@q&estado=@estado&desde=@desde&hasta=@hasta">@i</a>
                                            </li>
                                        }
                                    }
                                    @if (currentPage < totalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="?page=@(currentPage + 1)&q=@q&estado=@estado&desde=@desde&hasta=@hasta">Siguiente</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
    }

    /* Contenedor de acciones */
    .acciones-compras {
        min-width: 140px;
        justify-content: center;
        flex-wrap: nowrap;
        gap: 0.25rem;
    }

    /* Botones de acción */
    .btn-accion {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.375rem;
        flex-shrink: 0;
    }

    .compra-row:hover {
        background-color: #f8f9fa;
    }


    .acciones-compras form {
        display: inline;
        margin: 0;
    }

    /* Paginación */
    .pagination .page-link {
        color: #003566;
        border-color: #dee2e6;
    }

    .pagination .page-item.active .page-link {
        background-color: #003566;
        border-color: #003566;
        color: white;
    }

    .pagination .page-link:hover {
        background-color: #f8f9fa;
        color: #001d3d;
    }


    @@media (max-width: 768px) {
        .acciones-compras {
            min-width: auto;
            flex-direction: column;
            gap: 0.125rem;
        }

        .btn-accion {
            width: 28px;
            height: 28px;
            font-size: 0.7rem;
        }

        .pagination {
            flex-wrap: wrap;
            justify-content: center;
        }

        .card-body {
            padding: 1rem !important;
        }
    }


    .acciones-compras:has(.btn-accion:only-child) {
        min-width: 32px;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });


            document.querySelectorAll('form[asp-action="Cancelar"]').forEach(form => {
                form.addEventListener('submit', function(e) {
                    if (!confirm('¿Está seguro de que desea cancelar esta compra? Esta acción no se puede deshacer.')) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}