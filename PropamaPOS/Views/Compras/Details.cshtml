@model PropamaPOS.Models.Compra
@{
    ViewData["Title"] = "Detalle de Compra";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-receipt"></i> Detalle de Compra</h4>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Número de Compra:</strong> @Model.NumeroCompra
                </div>

                <div class="col-md-4">
                    <strong>Proveedor:</strong> @Model.Proveedor.Nombre
                </div>
                <div class="col-md-4">
                    <strong>Fecha:</strong> @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="col-md-4">
                    <strong>Registrada por:</strong> @Model.CreadoPor
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Nota))
            {
                <div class="mb-3">
                    <strong>Nota:</strong> @Model.Nota
                </div>
            }

            <table class="table table-striped table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Presentación</th>
                        <th>Cantidad</th>
                        <th>Precio Compra (Q)</th>
                        <th>Subtotal (Q)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var det in Model.Detalles)
                    {
                        <tr>
                            <td>@det.Item.Nombre</td>
                            <td>@det.Presentacion.UnidadMedida.Nombre (@det.Presentacion.Cantidad)</td>
                            <td>@det.CantidadPresentaciones</td>
                            <td>@det.PrecioCostoPorPresentacion.ToString("F2")</td>
                            <td>@det.Subtotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Total (Q):</th>
                        <th>@Model.Total.ToString("F2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

