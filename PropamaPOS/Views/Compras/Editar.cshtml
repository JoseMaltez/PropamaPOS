@model PropamaPOS.Models.ViewModels.CompraCrearViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Globalization
@{
    ViewData["Title"] = "Editar Compra";
    var proveedores = ViewBag.Proveedores as List<PropamaPOS.Models.Proveedor> ?? new();
    var compraId = ViewBag.Id_Compra ?? 0;
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertsPartial")

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-pencil-square fs-4 me-3"></i>
                            <h4 class="mb-0 fw-bold">Editar Compra</h4>
                        </div>
                        <a asp-action="Index" class="btn btn-light btn-sm d-flex align-items-center">
                            <i class="bi bi-arrow-left me-2"></i> Volver
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Editar" asp-route-id="@compraId" method="post" id="formCompra">
                        <!-- Información General -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-semibold text-dark">Proveedor *</label>
                                    <select asp-for="Id_Proveedor" class="form-select form-select-lg" required>
                                        <option value="">-- Seleccione proveedor --</option>
                                        @foreach (var p in proveedores)
                                        {
                                            <option value="@p.Id_Proveedor" selected="@(p.Id_Proveedor == Model.Id_Proveedor)">
                                                @p.Nombre
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="Id_Proveedor" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-semibold text-dark">Nota (opcional)</label>
                                    <input asp-for="Nota" class="form-control form-control-lg" placeholder="Ingrese una nota si es necesario" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Detalles de Compra -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="text-dark mb-0">
                                <i class="bi bi-list-check me-2"></i>Detalles de la Compra
                            </h5>
                            <button type="button" id="btnAgregar" class="btn btn-primary d-flex align-items-center">
                                <i class="bi bi-plus-circle me-2"></i> Agregar Producto
                            </button>
                        </div>

                        <!-- Tabla de Productos -->
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0" id="tablaLineas">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 ps-4">Producto</th>
                                        <th class="border-0">Presentación</th>
                                        <th class="border-0 text-center">Cantidad</th>
                                        <th class="border-0 text-end">Precio Compra (Q)</th>
                                        <th class="border-0 text-end">Subtotal (Q)</th>
                                        <th class="border-0 text-center pe-4">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <!-- Resumen de Totales -->
                        <div class="row justify-content-end mt-4">
                            <div class="col-md-6 col-lg-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted">Subtotal (sin IVA):</span>
                                            <strong id="subtotalText" class="text-dark">Q0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted">IVA:</span>
                                            <strong id="ivaText" class="text-dark">Q0.00</strong>
                                        </div>
                                        <hr class="my-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark">Total (con IVA):</span>
                                            <strong id="totalText" class="h5 text-primary">Q0.00</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botón de Envío -->
                        <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-warning btn-lg px-5 d-flex align-items-center text-dark">
                                <i class="bi bi-check-circle me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        overflow: visible !important;
    }

    .sugerenciasProducto {
        position: absolute !important;
        top: 100%;
        left: 0;
        width: 100%;
        z-index: 2000;
        display: none;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        max-height: 250px;
        overflow-y: auto;
    }

        .sugerenciasProducto .list-group-item {
            border: none;
            border-bottom: 1px solid #f1f3f4;
            padding: 0.75rem 1rem;
            transition: background-color 0.2s ease;
        }

            .sugerenciasProducto .list-group-item:hover {
                background-color: #f8f9fa;
                cursor: pointer;
            }

    .form-control:focus, .form-select:focus {
        border-color: #003566;
        box-shadow: 0 0 0 0.2rem rgba(0, 53, 102, 0.25);
    }

    .btn-warning {
        background-color: #ffc300;
        border-color: #ffc300;
        color: #000814;
    }

        .btn-warning:hover {
            background-color: #ffd60a;
            border-color: #ffd60a;
            color: #000814;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Items ?? new object[] { }));
        const lineasExistentes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lineas ?? new List<PropamaPOS.Models.ViewModels.CompraLineaCrearViewModel>()));
        const ivaRate = parseFloat('@(Configuration.GetValue<decimal?>("Tax:IVA")?.ToString(CultureInfo.InvariantCulture) ?? "0.12")') || 0.12;
        let index = 0;

        function calcularTotal() {
            let totalWithIva = 0;
            document.querySelectorAll('#tablaLineas tbody tr').forEach(tr => {
                const cantidad = parseFloat(tr.querySelector('.cantidad').value || 0);
                const precio = parseFloat(tr.querySelector('.precio').value || 0);
                totalWithIva += (cantidad * precio);
            });

            const subtotalWithoutIva = +(totalWithIva / (1 + ivaRate)).toFixed(2);
            const ivaTotal = +(totalWithIva - subtotalWithoutIva).toFixed(2);
            const total = +totalWithIva.toFixed(2);

            document.getElementById('subtotalText').innerText = 'Q' + subtotalWithoutIva.toFixed(2);
            document.getElementById('ivaText').innerText = 'Q' + ivaTotal.toFixed(2);
            document.getElementById('totalText').innerText = 'Q' + total.toFixed(2);
        }

        function crearFila(linea = null) {
            const tbody = document.querySelector("#tablaLineas tbody");
            const tr = document.createElement("tr");
            tr.className = 'fade-in';

            tr.innerHTML = `
                <td class="ps-4">
                    <div class="position-relative">
                        <input type="text" class="form-control buscarProducto" placeholder="Buscar producto..." autocomplete="off"
                               value="${linea && linea.NombreItem ? linea.NombreItem : ''}" />
                        <input type="hidden" name="Lineas[${index}].Id_Item" class="productoIdHidden" />
                        <div class="list-group position-absolute w-100 sugerenciasProducto"></div>
                    </div>
                </td>
                <td>
                    <select name="Lineas[${index}].Id_ItemPresentacion" class="form-select pres-select" required>
                        <option value="">-- Seleccione --</option>
                    </select>
                </td>
                <td>
                    <input type="number" name="Lineas[${index}].CantidadPresentaciones" min="1"
                           class="form-control text-center cantidad" value="${linea ? linea.CantidadPresentaciones : 1}" required />
                </td>
                <td>
                    <input type="number" step="0.01" name="Lineas[${index}].PrecioCostoPorPresentacion"
                           class="form-control text-end precio" value="${linea ? linea.PrecioCostoPorPresentacion : 0}" required />
                </td>
                <td class="text-end subtotal-cell fw-semibold">${linea ? (linea.CantidadPresentaciones * linea.PrecioCostoPorPresentacion).toFixed(2) : "0.00"}</td>
                <td class="text-center pe-4">
                    <button type="button" class="btn btn-outline-danger btn-sm eliminar">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(tr);

            // Cargar presentaciones si viene del servidor
            if (linea) {
                const presSelect = tr.querySelector(".pres-select");
                const item = items.find(i => i.presentaciones.some(p => p.id_ItemPresentacion === linea.Id_ItemPresentacion));
                if (item) {
                    tr.querySelector('.buscarProducto').value = item.nombre;
                    tr.querySelector('.productoIdHidden').value = item.id_Item;
                    presSelect.innerHTML = item.presentaciones.map(p =>
                        `<option value="${p.id_ItemPresentacion}" ${p.id_ItemPresentacion === linea.Id_ItemPresentacion ? "selected" : ""}>
                            ${p.unidadMedida.nombre} (${p.cantidad}) — Q${Number(p.precioVenta).toFixed(2)}
                         </option>`
                    ).join('');
                }
            }

            index++;
            calcularTotal();
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (lineasExistentes?.length) {
                lineasExistentes.forEach(l => crearFila(l));
            } else {
                crearFila();
            }
        });

        document.getElementById("btnAgregar").addEventListener("click", () => crearFila());

        // Búsqueda predictiva de productos
        document.addEventListener('input', function (e) {
            if (!e.target.classList.contains('buscarProducto')) return;

            const input = e.target;
            const contenedor = input.closest('td');
            const sugBox = contenedor.querySelector('.sugerenciasProducto');
            const q = input.value.trim().toLowerCase();

            if (!q) {
                sugBox.style.display = 'none';
                return;
            }

            const matches = items.filter(it =>
                (it.nombre && it.nombre.toLowerCase().includes(q))
            ).slice(0, 8);

            sugBox.innerHTML = '';
            if (!matches.length) {
                sugBox.style.display = 'none';
                return;
            }

            matches.forEach(m => {
                const el = document.createElement('button');
                el.type = 'button';
                el.className = 'list-group-item list-group-item-action text-start';
                el.innerHTML = `
                    <div class="fw-semibold">${m.nombre}</div>
                `;
                el.addEventListener('click', () => {
                    input.value = m.nombre;
                    contenedor.querySelector('.productoIdHidden').value = m.id_Item;

                    const row = input.closest('tr');
                    const presSelect = row.querySelector('.pres-select');
                    presSelect.innerHTML = '';

                    if (m.presentaciones && m.presentaciones.length > 0) {
                        presSelect.innerHTML = m.presentaciones.map(p =>
                            `<option value="${p.id_ItemPresentacion}">
                                ${p.unidadMedida.nombre} (${p.cantidad}) — Q${Number(p.precioVenta).toFixed(2)}
                            </option>`
                        ).join('');
                    } else {
                        presSelect.innerHTML = `<option value="">-- Sin presentaciones --</option>`;
                    }

                    sugBox.style.display = 'none';
                });
                sugBox.appendChild(el);
            });
            sugBox.style.display = 'block';
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('.sugerenciasProducto') && !e.target.classList.contains('buscarProducto')) {
                document.querySelectorAll('.sugerenciasProducto').forEach(l => l.style.display = 'none');
            }
        });

        document.querySelector("#tablaLineas tbody").addEventListener("input", function (e) {
            if (e.target.classList.contains("cantidad") || e.target.classList.contains("precio")) {
                const row = e.target.closest("tr");
                const cantidad = parseFloat(row.querySelector(".cantidad").value || 0);
                const precio = parseFloat(row.querySelector(".precio").value || 0);
                const subtotal = cantidad * precio;
                row.querySelector(".subtotal-cell").textContent = subtotal.toFixed(2);
                calcularTotal();
            }
        });

        document.querySelector("#tablaLineas tbody").addEventListener("click", function (e) {
            if (e.target.closest(".eliminar")) {
                e.target.closest("tr").remove();
                calcularTotal();
            }
        });

        document.getElementById("formCompra").addEventListener("submit", function (e) {
            if (document.querySelectorAll("#tablaLineas tbody tr").length === 0) {
                e.preventDefault();
                alert("Debe agregar al menos un producto a la compra.");
            }
        });
    </script>
}