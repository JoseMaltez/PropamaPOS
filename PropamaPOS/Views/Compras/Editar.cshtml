@model PropamaPOS.Models.ViewModels.CompraCrearViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Globalization
@{
    ViewData["Title"] = "Editar Compra";
    var proveedores = ViewBag.Proveedores as List<PropamaPOS.Models.Proveedor> ?? new();
    var compraId = ViewBag.Id_Compra ?? 0;
}

<div class="container mt-4">
    @await Html.PartialAsync("_AlertsPartial")
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Compra</h4>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card-body">
            <form asp-action="Editar" asp-route-id="@compraId" method="post" id="formCompra">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Proveedor</label>
                        <select asp-for="Id_Proveedor" class="form-select" required>
                            <option value="">-- Seleccione proveedor --</option>
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.Id_Proveedor" selected="@(p.Id_Proveedor == Model.Id_Proveedor)">
                                    @p.Nombre
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Id_Proveedor" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Nota (opcional)</label>
                        <input asp-for="Nota" class="form-control" />
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Detalles de la compra</h5>
                    <button type="button" id="btnAgregar" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus"></i> Agregar producto
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle" id="tablaLineas">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Presentación</th>
                                <th>Cantidad</th>
                                <th>Precio compra (Q)</th>
                                <th>Subtotal (Q)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="mt-3 text-end">
                    <div>Subtotal (sin IVA): <strong id="subtotalText">Q0.00</strong></div>
                    <div>IVA: <strong id="ivaText">Q0.00</strong></div>
                    <div class="h5">Total (con IVA): <strong id="totalText">Q0.00</strong></div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-warning px-4 text-dark">
                        <i class="bi bi-check-circle"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Serializar los datos del servidor
        const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Items ?? new object[] { }));
        const lineasExistentes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lineas ?? new List<PropamaPOS.Models.ViewModels.CompraLineaCrearViewModel>()));
        const ivaRate = parseFloat('@(Configuration.GetValue<decimal?>("Tax:IVA")?.ToString(CultureInfo.InvariantCulture) ?? "0.12")') || 0.12;

        let index = 0;

        function calcularTotal() {
            let totalWithIva = 0;
            document.querySelectorAll('#tablaLineas tbody tr').forEach(tr => {
                const cantidad = parseFloat(tr.querySelector('.cantidad').value || 0);
                const precio = parseFloat(tr.querySelector('.precio').value || 0);
                totalWithIva += (cantidad * precio);
            });

            const subtotalWithoutIva = +(totalWithIva / (1 + ivaRate)).toFixed(2);
            const ivaTotal = +(totalWithIva - subtotalWithoutIva).toFixed(2);
            const total = +totalWithIva.toFixed(2);

            document.getElementById('subtotalText').innerText = 'Q' + subtotalWithoutIva.toFixed(2);
            document.getElementById('ivaText').innerText = 'Q' + ivaTotal.toFixed(2);
            document.getElementById('totalText').innerText = 'Q' + total.toFixed(2);
        }

        function crearFila(linea = null) {
            const tbody = document.querySelector("#tablaLineas tbody");
            const tr = document.createElement("tr");

            tr.innerHTML = `
                <td>
                    <select class="form-select form-select-sm item-select" data-index="${index}">
                        <option value="">-- Producto --</option>
                        ${items.map(i => `<option value="${i.id_Item}">${i.nombre}</option>`).join("")}
                    </select>
                </td>
                <td>
                    <select name="Lineas[${index}].Id_ItemPresentacion" class="form-select form-select-sm pres-select" required></select>
                </td>
                <td>
                    <input type="number" name="Lineas[${index}].CantidadPresentaciones" min="1" class="form-control form-control-sm cantidad" value="${linea ? linea.cantidadPresentaciones : 1}" required />
                </td>
                <td>
                    <input type="number" step="0.01" name="Lineas[${index}].PrecioCostoPorPresentacion" class="form-control form-control-sm precio" value="${linea ? linea.precioCostoPorPresentacion : 0}" required />
                </td>
                <td class="subtotal-cell">0.00</td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm eliminar"><i class="bi bi-trash"></i></button>
                </td>
            `;

            tbody.appendChild(tr);

            const itemSelect = tr.querySelector(".item-select");
            const presSelect = tr.querySelector(".pres-select");

            // Si hay una línea existente, seleccionamos su presentación
            if (linea) {
                const presId = linea.id_ItemPresentacion;
                const item = items.find(i => i.presentaciones.some(p => p.id_ItemPresentacion === presId));
                if (item) {
                    itemSelect.value = item.id_Item;
                    presSelect.innerHTML = item.presentaciones.map(p =>
                        `<option value="${p.id_ItemPresentacion}" ${p.id_ItemPresentacion === presId ? "selected" : ""}>
                            ${p.unidadMedida.nombre} (${p.cantidad}) — Q${Number(p.precioVenta).toFixed(2)}
                         </option>`).join("");
                }
                const cantidad = parseFloat(linea.cantidadPresentaciones || 0);
                const precio = parseFloat(linea.precioCostoPorPresentacion || 0);
                tr.querySelector(".subtotal-cell").textContent = (cantidad * precio).toFixed(2);
            }
            index++;
            calcularTotal();
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (lineasExistentes && lineasExistentes.length > 0) {
                lineasExistentes.forEach(l => crearFila({
                    id_ItemPresentacion: l.Id_ItemPresentacion,
                    cantidadPresentaciones: l.CantidadPresentaciones,
                    precioCostoPorPresentacion: l.PrecioCostoPorPresentacion
                }));
            }
        });

        document.getElementById("btnAgregar").addEventListener("click", () => crearFila());

        // Al cambiar producto
        document.querySelector("#tablaLineas tbody").addEventListener("change", function (e) {
            if (e.target.classList.contains("item-select")) {
                const itemId = parseInt(e.target.value);
                const row = e.target.closest("tr");
                const presSelect = row.querySelector(".pres-select");
                presSelect.innerHTML = "";

                const item = items.find(i => i.id_Item === itemId);
                if (item && item.presentaciones && item.presentaciones.length > 0) {
                    presSelect.innerHTML = item.presentaciones.map(p =>
                        `<option value="${p.id_ItemPresentacion}">
                            ${p.unidadMedida.nombre} (${p.cantidad}) — Q${Number(p.precioVenta).toFixed(2)}
                         </option>`).join("");
                } else {
                    presSelect.innerHTML = `<option value="">-- Sin presentaciones --</option>`;
                }
            }
        });

        // Cambios en cantidad o precio
        document.querySelector("#tablaLineas tbody").addEventListener("input", function (e) {
            if (e.target.classList.contains("cantidad") || e.target.classList.contains("precio")) {
                const row = e.target.closest("tr");
                const cantidad = parseFloat(row.querySelector(".cantidad").value || 0);
                const precio = parseFloat(row.querySelector(".precio").value || 0);
                row.querySelector(".subtotal-cell").textContent = (cantidad * precio).toFixed(2);
                calcularTotal();
            }
        });

        // Eliminar fila
        document.querySelector("#tablaLineas tbody").addEventListener("click", function (e) {
            if (e.target.closest(".eliminar")) {
                e.target.closest("tr").remove();
                calcularTotal();
            }
        });

        document.getElementById("formCompra").addEventListener("submit", function (e) {
            if (document.querySelectorAll("#tablaLineas tbody tr").length === 0) {
                e.preventDefault();
                alert("Debe agregar al menos un producto a la compra.");
            }
        });
    </script>
}
