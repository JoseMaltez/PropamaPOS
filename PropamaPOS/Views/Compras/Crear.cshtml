@model PropamaPOS.Models.ViewModels.CompraCrearViewModel
@{
    ViewData["Title"] = "Registrar Compra";
    var proveedores = ViewBag.Proveedores as List<PropamaPOS.Models.Proveedor> ?? new();
    // NO castear ViewBag.Items a List<Item> aquí (el controller proyecta un anon object)
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-cart-plus"></i> Registrar Compra</h4>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <div class="card-body">
            <form asp-action="Crear" method="post" id="formCompra">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Proveedor</label>
                        <select asp-for="Id_Proveedor" class="form-select" required>
                            <option value="">-- Seleccione proveedor --</option>
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.Id_Proveedor">@p.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="Id_Proveedor" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Fecha</label>
                        <input asp-for="Fecha" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Nota (opcional)</label>
                        <input asp-for="Nota" class="form-control" />
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Detalles de la compra</h5>
                    <button type="button" id="btnAgregar" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus"></i> Agregar producto
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle" id="tablaLineas">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Presentación</th>
                                <th>Cantidad</th>
                                <th>Precio compra (Q)</th>
                                <th>Subtotal (Q)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4" class="text-end">Total (Q):</th>
                                <th id="totalCompra" class="fw-bold">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle"></i> Registrar Compra
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Serializamos directamente el ViewBag desde el servidor a JS.
        const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Items ?? new object[] { }));
        let index = 0;

        function calcularTotal() {
            let total = 0;
            document.querySelectorAll(".subtotal-cell").forEach(cell => {
                total += parseFloat(cell.textContent || 0);
            });
            document.getElementById("totalCompra").textContent = total.toFixed(2);
        }

        function agregarFila() {
            const tbody = document.querySelector("#tablaLineas tbody");
            const tr = document.createElement("tr");

            tr.innerHTML = `
                <td>
                    <select class="form-select form-select-sm item-select" data-index="${index}">
                        <option value="">-- Producto --</option>
                        ${items.map(i => `<option value="${i.id_Item}">${i.nombre}</option>`).join("")}
                    </select>
                </td>
                <td>
                    <select name="Lineas[${index}].Id_ItemPresentacion" class="form-select form-select-sm pres-select" required></select>
                </td>
                <td>
                    <input type="number" name="Lineas[${index}].CantidadPresentaciones" value="1" min="1" class="form-control form-control-sm cantidad" required />
                </td>
                <td>
                    <input type="number" step="0.01" name="Lineas[${index}].PrecioCostoPorPresentacion" value="0" class="form-control form-control-sm precio" required />
                </td>
                <td class="subtotal-cell">0.00</td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm eliminar"><i class="bi bi-trash"></i></button>
                </td>
            `;

            tbody.appendChild(tr);
            index++;
        }

        document.getElementById("btnAgregar").addEventListener("click", agregarFila);

        // Cuando seleccionan producto, llenamos presentaciones correspondientes
        document.querySelector("#tablaLineas tbody").addEventListener("change", function (e) {
            if (e.target.classList.contains("item-select")) {
                const itemId = parseInt(e.target.value);
                const row = e.target.closest("tr");
                const presSelect = row.querySelector(".pres-select");
                presSelect.innerHTML = "";

                if (!itemId) return;
                const item = items.find(i => i.id_Item === itemId);
                if (item && item.presentaciones && item.presentaciones.length > 0) {
                    presSelect.innerHTML = item.presentaciones.map(p =>
                        `<option value="${p.id_ItemPresentacion}">
                            ${p.cantidad} ${p.unidadMedida.nombre} — Q${Number(p.precioVenta).toFixed(2)}
                         </option>`).join("");
                } else {
                    presSelect.innerHTML = `<option value="">-- Sin presentaciones --</option>`;
                }
            }
        });

        document.querySelector("#tablaLineas tbody").addEventListener("input", function (e) {
            if (e.target.classList.contains("cantidad") || e.target.classList.contains("precio")) {
                const row = e.target.closest("tr");
                const cantidad = parseFloat(row.querySelector(".cantidad").value || 0);
                const precio = parseFloat(row.querySelector(".precio").value || 0);
                const subtotal = cantidad * precio;
                row.querySelector(".subtotal-cell").textContent = subtotal.toFixed(2);
                calcularTotal();
            }
        });

        document.querySelector("#tablaLineas tbody").addEventListener("click", function (e) {
            if (e.target.closest(".eliminar")) {
                e.target.closest("tr").remove();
                calcularTotal();
            }
        });

        document.getElementById("formCompra").addEventListener("submit", function (e) {
            if (document.querySelectorAll("#tablaLineas tbody tr").length === 0) {
                e.preventDefault();
                alert("Debe agregar al menos un producto a la compra.");
            }
        });
    </script>
}
