﻿@using System.Security.Claims
@model IEnumerable<PropamaPOS.Models.Empleado>

@{
    ViewData["Title"] = "Gestión de Empleados";
    string q = ViewBag.CurrentQuery as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    var roles = ViewBag.Roles as List<PropamaPOS.Models.Rol> ?? new();
    int? selectedRol = ViewBag.RolId as int?;
    string desde = ViewBag.Desde as string;
    string hasta = ViewBag.Hasta as string;
}

<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary-dark-blue mb-1">
                <i class="bi bi-people-fill me-2"></i>Gestión de Empleados
            </h2>
            <p class="text-muted mb-0">Administra los empleados del sistema</p>
        </div>
        <a asp-action="CrearEmpleado" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Crear Empleado
        </a>
    </div>

    <!-- Filtros -->
    <div class="filter-card">
        <div class="card-header bg-light border-bottom py-3">
            <h6 class="mb-0 text-primary-dark-blue">
                <i class="bi bi-funnel me-2"></i>Filtros de Búsqueda
            </h6>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Empleados" class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-medium">Buscar</label>
                    <input type="text" name="q" value="@q" class="form-control"
                           placeholder="Nombre, usuario, correo, teléfono..." />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-medium">Rol</label>
                    <select name="rolId" class="form-select">
                        <option value="">Todos los roles</option>
                        @foreach (var r in roles)
                        {
                            <option value="@r.Id_Rol" selected="@(selectedRol == r.Id_Rol)">
                                @r.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-medium">Desde</label>
                    <input type="date" name="desde" value="@desde" class="form-control" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-medium">Hasta</label>
                    <input type="date" name="hasta" value="@hasta" class="form-control" />
                </div>

                <div class="col-lg-1 col-md-12">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" title="Aplicar filtros">
                            <i class="bi bi-search"></i>
                        </button>
                        <a asp-action="Empleados" class="btn btn-outline-secondary" title="Limpiar filtros">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_AlertsPartial")

    <!-- Lista de empleados -->
    <div class="dashboard-card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-list-ul me-2 fs-5"></i>
                <h5 class="mb-0">Lista de Empleados</h5>
            </div>
            <div class="d-flex align-items-center">
                <span class="badge bg-light text-dark fs-6">@totalItems registros</span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-people empty-icon"></i>
                    <h5>No se encontraron empleados</h5>
                    <p class="text-muted mb-4">Puedes agregar un empleado nuevo</p>
                    <a asp-action="CrearEmpleado" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Crear Empleado
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-admin">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Información Personal</th>
                                <th>Contacto</th>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Fecha Contratación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var empleado in Model)
                            {
                                <tr>
                                    <td class="fw-medium">#@empleado.Id_Empleado</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0">
                                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center"
                                                     style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person-fill text-white"></i>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="mb-0">@empleado.Nombre @empleado.Apellido</h6>
                                                <small class="text-muted">ID: @empleado.Id_Empleado</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div class="mb-1">
                                                <i class="bi bi-envelope me-2 text-muted"></i>
                                                <small>@empleado.Correo</small>
                                            </div>
                                            <div>
                                                <i class="bi bi-telephone me-2 text-muted"></i>
                                                <small>@empleado.Telefono</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-medium">@empleado.Usuario.NombreUsuario</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-admin @(empleado.Usuario.Rol?.Nombre == "Admin" ? "badge-role-admin" : "badge-role-empleado")">
                                            @empleado.Usuario.Rol?.Nombre
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-medium">@empleado.FechaContratacion.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-action-group">
                                            <a asp-action="EditarEmpleado" asp-route-id="@empleado.Id_Empleado"
                                               class="btn btn-edit btn-action" title="Editar empleado">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="EliminarEmpleado" asp-route-id="@empleado.Id_Empleado"
                                               class="btn btn-delete btn-action" title="Eliminar empleado">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-light py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-muted">
                                Mostrando página <strong>@currentPage</strong> de <strong>@totalPages</strong>
                                - Total: <strong>@totalItems</strong> registros
                            </div>
                            <nav>
                                <ul class="pagination pagination-admin mb-0">
                                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           asp-action="Empleados"
                                           asp-route-page="@(currentPage - 1)"
                                           asp-route-q="@q"
                                           asp-route-rolId="@selectedRol"
                                           asp-route-desde="@desde"
                                           asp-route-hasta="@hasta">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>

                                    @for (int i = 1; i <= totalPages; i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link"
                                               asp-action="Empleados"
                                               asp-route-page="@i"
                                               asp-route-q="@q"
                                               asp-route-rolId="@selectedRol"
                                               asp-route-desde="@desde"
                                               asp-route-hasta="@hasta">@i</a>
                                        </li>
                                    }

                                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           asp-action="Empleados"
                                           asp-route-page="@(currentPage + 1)"
                                           asp-route-q="@q"
                                           asp-route-rolId="@selectedRol"
                                           asp-route-desde="@desde"
                                           asp-route-hasta="@hasta">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>