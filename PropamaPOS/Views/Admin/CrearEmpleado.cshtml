@model PropamaPOS.Models.ViewModels.CrearEmpleadoViewModel
@{
    ViewData["Title"] = "Crear Empleado";
}

<div class="container-fluid mt-4 fade-in">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="admin-form-card">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-plus-fill me-3 fs-4"></i>
                        <div>
                            <h4 class="mb-0">Crear Nuevo Empleado</h4>
                            <small class="opacity-75">Complete la información para registrar un nuevo empleado en el sistema</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CrearEmpleado" method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Datos de Usuario -->
                        <div class="mb-5">
                            <h5 class="form-section-title">
                                <i class="bi bi-person-badge me-2"></i>Datos de Usuario
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="NombreUsuario" class="form-label fw-medium">Nombre de Usuario *</label>
                                    <input asp-for="NombreUsuario" class="form-control" 
                                           placeholder="Ingrese el nombre de usuario" required />
                                    <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                                    <div class="form-text">El nombre de usuario debe ser único en el sistema.</div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Id_Rol" class="form-label fw-medium">Rol *</label>
                                    <select asp-for="Id_Rol" class="form-select" required
                                            asp-items="@(new SelectList(ViewBag.Roles, "Id_Rol", "Nombre"))">
                                        <option value="">Seleccionar Rol...</option>
                                    </select>
                                    <span asp-validation-for="Id_Rol" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label fw-medium">Contraseña *</label>
                                    <div class="input-group">
                                        <input asp-for="Password" type="password" class="form-control" id="passwordInput"
                                               placeholder="Ingrese la contraseña" required />
                                        <button type="button" class="btn btn-outline-secondary toggle-password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>

                                    <!-- Validación de contraseña -->
                                    <div class="password-validation mt-2">
                                        <small class="text-muted fw-medium">La contraseña debe cumplir con:</small>
                                        <div class="validation-item" id="req-length">
                                            <i class="bi bi-x-circle text-danger"></i>
                                            <span>Mínimo 8 caracteres</span>
                                        </div>
                                        <div class="validation-item" id="req-upper">
                                            <i class="bi bi-x-circle text-danger"></i>
                                            <span>1 letra mayúscula (A-Z)</span>
                                        </div>
                                        <div class="validation-item" id="req-lower">
                                            <i class="bi bi-x-circle text-danger"></i>
                                            <span>1 letra minúscula (a-z)</span>
                                        </div>
                                        <div class="validation-item" id="req-number">
                                            <i class="bi bi-x-circle text-danger"></i>
                                            <span>1 número (0-9)</span>
                                        </div>
                                        <div class="validation-item" id="req-special">
                                            <i class="bi bi-x-circle text-danger"></i>
                                            <span>1 carácter especial (&#64;&#35;&#36;&#37;&#94;&amp;&#42;&#33;&#63;)</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label fw-medium">Confirmar Contraseña *</label>
                                    <div class="input-group">
                                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                                               placeholder="Repita la contraseña" required />
                                        <button type="button" class="btn btn-outline-secondary toggle-password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                    <div class="form-text">Ambas contraseñas deben coincidir.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Datos Personales -->
                        <div class="mb-4">
                            <h5 class="form-section-title">
                                <i class="bi bi-person-vcard me-2"></i>Datos Personales
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Nombre" class="form-label fw-medium">Nombre *</label>
                                    <input asp-for="Nombre" class="form-control" 
                                           placeholder="Ingrese el nombre" required />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Apellido" class="form-label fw-medium">Apellido *</label>
                                    <input asp-for="Apellido" class="form-control" 
                                           placeholder="Ingrese el apellido" required />
                                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label asp-for="Correo" class="form-label fw-medium">Correo Electrónico *</label>
                                    <input asp-for="Correo" type="email" class="form-control" 
                                           placeholder="ejemplo@correo.com" required />
                                    <span asp-validation-for="Correo" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Telefono" class="form-label fw-medium">Teléfono *</label>
                                    <input asp-for="Telefono" class="form-control" 
                                           placeholder="Ingrese el teléfono" />
                                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label asp-for="FechaContratacion" class="form-label fw-medium">Fecha de Contratación *</label>
                                    <input asp-for="FechaContratacion" type="date" class="form-control" required />
                                    <span asp-validation-for="FechaContratacion" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a asp-action="Empleados" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Volver a la Lista
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-2"></i>Crear Empleado
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("passwordInput");
            const validationItems = {
                length: document.getElementById("req-length"),
                upper: document.getElementById("req-upper"),
                lower: document.getElementById("req-lower"),
                number: document.getElementById("req-number"),
                special: document.getElementById("req-special")
            };

            passwordInput.addEventListener("input", function () {
                const value = passwordInput.value;

                const validations = {
                    length: value.length >= 8,
                    upper: /[A-Z]/.test(value),
                    lower: /[a-z]/.test(value),
                    number: /\d/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                Object.keys(validations).forEach(key => {
                    const isValid = validations[key];
                    const item = validationItems[key];
                    const icon = item.querySelector("i");

                    if (isValid) {
                        item.classList.add("validation-valid");
                        item.classList.remove("validation-invalid");
                        icon.className = "bi bi-check-circle text-success";
                    } else {
                        item.classList.add("validation-invalid");
                        item.classList.remove("validation-valid");
                        icon.className = "bi bi-x-circle text-danger";
                    }
                });
            });

            // Toggle password
            document.querySelectorAll(".toggle-password").forEach(button => {
                button.addEventListener("click", function () {
                    const input = this.parentElement.querySelector("input");
                    const icon = this.querySelector("i");

                    if (input.type === "password") {
                        input.type = "text";
                        icon.className = "bi bi-eye-slash";
                    } else {
                        input.type = "password";
                        icon.className = "bi bi-eye";
                    }
                });
            });
        });
    </script>
}