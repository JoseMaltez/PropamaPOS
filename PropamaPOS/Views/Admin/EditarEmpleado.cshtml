@model PropamaPOS.Models.ViewModels.EditarEmpleadoViewModel
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="container-fluid mt-4 fade-in">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="admin-form-card">
                <div class="card-header bg-warning text-dark py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-gear me-3 fs-4"></i>
                        <div>
                            <h4 class="mb-0">Editar Empleado</h4>
                            <small class="opacity-75">Actualice la información del empleado seleccionado</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditarEmpleado" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id_Empleado" />
                        <input type="hidden" asp-for="Id_Usuario" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Datos de Usuario -->
                        <div class="mb-5">
                            <h5 class="form-section-title">
                                <i class="bi bi-person-badge me-2"></i>Datos de Usuario
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="NombreUsuario" class="form-label fw-medium">Nombre de Usuario *</label>
                                    <input asp-for="NombreUsuario" class="form-control" required />
                                    <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Id_Rol" class="form-label fw-medium">Rol *</label>
                                    <select asp-for="Id_Rol" class="form-select" required
                                            asp-items="@(new SelectList(ViewBag.Roles, "Id_Rol", "Nombre"))">
                                        <option value="">Seleccionar Rol...</option>
                                    </select>
                                    <span asp-validation-for="Id_Rol" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mt-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Cambiar Contraseña</label>
                                    <div class="input-group">
                                        <input asp-for="Password" type="password" class="form-control" 
                                               placeholder="Dejar en blanco para no cambiar" />
                                        <button type="button" class="btn btn-outline-secondary toggle-password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                    <div class="form-text">Mínimo 8 caracteres con mayúsculas, minúsculas, números y caracteres especiales.</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Confirmar Contraseña</label>
                                    <div class="input-group">
                                        <input asp-for="ConfirmPassword" type="password" class="form-control" 
                                               placeholder="Confirmar nueva contraseña" />
                                        <button type="button" class="btn btn-outline-secondary toggle-password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Datos Personales -->
                        <div class="mb-4">
                            <h5 class="form-section-title">
                                <i class="bi bi-person-vcard me-2"></i>Datos Personales
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Nombre" class="form-label fw-medium">Nombre *</label>
                                    <input asp-for="Nombre" class="form-control" required />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Apellido" class="form-label fw-medium">Apellido *</label>
                                    <input asp-for="Apellido" class="form-control" required />
                                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label asp-for="Correo" class="form-label fw-medium">Correo Electrónico *</label>
                                    <input asp-for="Correo" type="email" class="form-control" required />
                                    <span asp-validation-for="Correo" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Telefono" class="form-label fw-medium">Teléfono</label>
                                    <input asp-for="Telefono" class="form-control" />
                                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label asp-for="FechaContratacion" class="form-label fw-medium">Fecha de Contratación *</label>
                                    <input asp-for="FechaContratacion" type="date" class="form-control" required />
                                    <span asp-validation-for="FechaContratacion" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a asp-action="Empleados" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Cancelar
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="EliminarEmpleado" asp-route-id="@Model.Id_Empleado" 
                                   class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-2"></i>Eliminar
                                </a>
                                <button type="submit" class="btn btn-warning px-4">
                                    <i class="bi bi-check-circle me-2"></i>Actualizar Empleado
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Toggle password
            document.querySelectorAll(".toggle-password").forEach(button => {
                button.addEventListener("click", function () {
                    const input = this.parentElement.querySelector("input");
                    const icon = this.querySelector("i");

                    if (input.type === "password") {
                        input.type = "text";
                        icon.className = "bi bi-eye-slash";
                    } else {
                        input.type = "password";
                        icon.className = "bi bi-eye";
                    }
                });
            });
        });
    </script>
}