﻿@{
ViewData["Title"] = "Dashboard Administrador";
}

<div class="container-fluid mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary-dark-blue">
            <i class="bi bi-speedometer2 me-2"></i>Panel de Administración
        </h2>
        <div class="text-muted">
            <small>Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
    </div>

    <!-- Estadísticas principales -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card card-primary">
                <div class="card-body">
                    <i class="bi bi-people dashboard-icon"></i>
                    <div class="dashboard-stat">@ViewBag.TotalEmpleados</div>
                    <span class="dashboard-label">Empleados Registrados</span>
                    <a asp-action="Empleados" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="bi bi-arrow-right me-1"></i>Gestionar
                    </a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card card-warning">
                <div class="card-body">
                    <i class="bi bi-building dashboard-icon"></i>
                    <div class="dashboard-stat">@ViewBag.TotalProveedores</div>
                    <span class="dashboard-label">Proveedores Activos</span>
                    <a asp-controller="Proveedor" asp-action="Index" class="btn btn-sm btn-outline-warning mt-2">
                        <i class="bi bi-arrow-right me-1"></i>Ver
                    </a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card card-success">
                <div class="card-body">
                    <i class="bi bi-person-check dashboard-icon"></i>
                    <div class="dashboard-stat">@ViewBag.TotalClientes</div>
                    <span class="dashboard-label">Clientes Registrados</span>
                    <a asp-controller="Cliente" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">
                        <i class="bi bi-arrow-right me-1"></i>Ver
                    </a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card card-info">
                <div class="card-body">
                    <i class="bi bi-box-seam dashboard-icon"></i>
                    <div class="dashboard-stat">@ViewBag.TotalItems</div>
                    <span class="dashboard-label">Productos/Servicios</span>
                    <a asp-controller="Item" asp-action="Index" class="btn btn-sm btn-outline-info mt-2">
                        <i class="bi bi-arrow-right me-1"></i>Ver
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas importantes -->
    @if (ViewBag.BajoStock > 0)
    {
        <div class="alert alert-warning dashboard-alert d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4 text-warning"></i>
                <div>
                    <h6 class="alert-heading mb-1">Stock Bajo Detectado</h6>
                    <p class="mb-0"><strong>@ViewBag.BajoStock</strong> producto(s) están por debajo del nivel de stock mínimo.</p>
                </div>
            </div>
            <a asp-controller="Item" asp-action="Index" asp-route-bajoStock="true" class="btn btn-warning btn-sm">
                <i class="bi bi-box-seam me-1"></i> Revisar Stock
            </a>
        </div>
    }

    <!-- Estadísticas secundarias -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-primary mb-0">
                            <i class="bi bi-cart me-2"></i>Compras Pendientes
                        </h5>
                        <span class="badge bg-warning text-dark fs-6">@ViewBag.ComprasPendientes</span>
                    </div>
                    <p class="text-muted mb-3">Compras que requieren atención inmediata</p>
                    <a asp-controller="Compras" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-right me-1"></i>Revisar Compras
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="dashboard-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-success mb-0">
                            <i class="bi bi-cash-coin me-2"></i>Ventas de Hoy
                        </h5>
                        <span class="badge bg-success fs-6">@ViewBag.VentasHoy</span>
                    </div>
                    <p class="text-muted mb-3">Ventas registradas en el día de hoy</p>
                    <a asp-controller="Ventas" asp-action="Index" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-arrow-right me-1"></i>Ver Ventas
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimas Ventas -->
    <div class="dashboard-card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 text-primary-dark-blue">
                <i class="bi bi-clock-history me-2"></i>Últimas 5 Ventas
            </h5>
            <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-list-ul me-1"></i>Ver Todas
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-admin mb-0">
                    <thead>
                        <tr>
                            <th>Fecha y Hora</th>
                            <th>Cliente</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in ViewBag.UltimasVentas)
                        {
                            <tr>
                                <td class="fw-medium">@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(v.Cliente?.Nombre ?? "Consumidor Final")</td>
                                <td class="text-end fw-bold text-success">Q@(v.Total.ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .text-primary-dark-blue {
        color: var(--primary-dark-blue);
    }
</style>