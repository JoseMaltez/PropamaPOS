<!-- Views/Admin/Dashboard.cshtml -->
@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container mt-4">
    <h2 class="mb-4">Panel de Administración</h2>

    <div class="row">
        <!-- Empleados -->
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">👥 Empleados</h5>
                    <p class="card-text">Gestiona empleados del sistema</p>
                    <a asp-action="Empleados" class="btn btn-primary">Administrar</a>
                </div>
            </div>
        </div>

        <!-- Proveedores -->
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">🏭 Proveedores</h5>
                    <p class="card-text">Gestiona proveedores del sistema</p>
                    <a asp-controller="Proveedor" asp-action="Index" class="btn btn-warning">Administrar</a>
                </div>
            </div>
        </div>

        <!-- Configuración -->
        <div class="col-md-4 mb-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">⚙️ Configuración</h5>
                    <p class="card-text">Cambgiar los ajustes del sistema</p>
                    <a href="#" class="btn btn-danger">Cambiar configuración</a>
                </div>
            </div>
        </div>
    </div>
</div>