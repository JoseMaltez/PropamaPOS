@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-speedometer2"></i> Panel de Administración</h2>

    <!-- KPIs -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="bi bi-people fs-1 text-primary"></i>
                    <h4 class="mt-2">@ViewBag.TotalEmpleados</h4>
                    <p class="text-muted mb-1">Empleados</p>
                    <a asp-action="Empleados" class="btn btn-outline-primary btn-sm">Ver</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="bi bi-building fs-1 text-warning"></i>
                    <h4 class="mt-2">@ViewBag.TotalProveedores</h4>
                    <p class="text-muted mb-1">Proveedores</p>
                    <a asp-controller="Proveedor" asp-action="Index" class="btn btn-outline-warning btn-sm">Ver</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="bi bi-person-check fs-1 text-success"></i>
                    <h4 class="mt-2">@ViewBag.TotalClientes</h4>
                    <p class="text-muted mb-1">Clientes</p>
                    <a asp-controller="Cliente" asp-action="Index" class="btn btn-outline-success btn-sm">Ver</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="bi bi-box-seam fs-1 text-info"></i>
                    <h4 class="mt-2">@ViewBag.TotalItems</h4>
                    <p class="text-muted mb-1">Productos</p>
                    <a asp-controller="Item" asp-action="Index" class="btn btn-outline-info btn-sm">Ver</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (ViewBag.BajoStock > 0)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between shadow-sm" role="alert">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <strong>@ViewBag.BajoStock</strong> producto(s) están por debajo del nivel de stock mínimo.
            </div>
            <a asp-controller="Item" asp-action="Index" asp-route-bajoStock="true" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-box-seam"></i> Ver productos
            </a>
        </div>
    }
    <!-- Tarjetas secundarias -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary"><i class="bi bi-cart"></i> Compras Pendientes</h5>
                    <h3 class="fw-bold">@ViewBag.ComprasPendientes</h3>
                    <p class="text-muted">Compras aún no procesadas</p>
                    <a asp-controller="Compras" asp-action="Index" class="btn btn-outline-primary btn-sm">Revisar</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-success"><i class="bi bi-cash"></i> Ventas de Hoy</h5>
                    <h3 class="fw-bold">@ViewBag.VentasHoy</h3>
                    <p class="text-muted">Ventas registradas hoy</p>
                    <a asp-controller="Ventas" asp-action="Index" class="btn btn-outline-success btn-sm">Ver ventas</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimas Ventas -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Últimas 5 Ventas</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in ViewBag.UltimasVentas)
                    {
                        <tr>
                            <td>@v.Fecha.ToString("g")</td>
                            <td>@(v.Cliente?.Nombre ?? "Consumidor Final")</td>
                            <td>Q@(v.Total.ToString("F2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
