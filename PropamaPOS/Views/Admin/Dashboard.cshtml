@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container mt-4">
    <h2 class="mb-3">Panel de Administración</h2>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">👥 Empleados</h6>
                    <h3>@ViewBag.TotalEmpleados</h3>
                    <p class="mb-0">Empleados registrados</p>
                    <a asp-action="Empleados" class="btn btn-sm btn-outline-primary mt-2">Administrar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">🏭 Proveedores</h6>
                    <h3>@ViewBag.TotalProveedores</h3>
                    <p class="mb-0">Proveedores activos</p>
                    <a asp-controller="Proveedor" asp-action="Index" class="btn btn-sm btn-outline-warning mt-2">Ir</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">🙋‍♂️ Clientes</h6>
                    <h3>@ViewBag.TotalClientes</h3>
                    <p class="mb-0">Clientes registrados</p>
                    <a asp-controller="Cliente" asp-action="Index" class="btn btn-sm btn-outline-info mt-2">Ir</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="card-title">📦 Productos</h6>
                    <h3>@ViewBag.TotalItems</h3>
                    <p class="mb-0">Items en catálogo</p>
                    <a asp-controller="Item" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Ir</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="card-title">📥 Compras pendientes</h6>
                    <h3>@ViewBag.ComprasPendientes</h3>
                    <p class="mb-0">Compras por recibir</p>
                    <a asp-controller="Compras" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">Revisar</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="card-title">💰 Ventas hoy</h6>
                    <h3>@ViewBag.VentasHoy</h3>
                    <p class="mb-0">Ventas registradas hoy</p>
                    <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Ir</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <p class="text-muted small">Panel simple y realista — suficiente para el proyecto final. Si quieres, puedo añadir gráficos simples después.</p>
    </div>
</div>
